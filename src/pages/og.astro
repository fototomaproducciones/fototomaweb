---
// Lienzo de 1200 × 630 para la imagen que aparece al compartir el sitio.
// No se enlaza: scripts/exportar-marca.mjs le toma una foto y la guarda en public/og.jpg.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource/lato/700.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Foto from '../components/Foto.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og</title>
  </head>
  <body>
    <div class="lienzo">
      <Foto src="obra/2xwhnGZxArw.jpg" sizes="1200px" anchos={[1280]} prioridad posicion="center 62%" />
      <div class="texto">
        <Logo tam={78} />
        <p class="serif">Música para la imagen</p>
        <p class="pie">Cine · documental · publicidad · sesiones en vivo</p>
      </div>
    </div>
    <style>
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
      .lienzo {
        position: relative;
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
      .lienzo :global(picture),
      .lienzo :global(img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .lienzo::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(20, 18, 15, 0.88), rgba(20, 18, 15, 0.35) 65%, rgba(20, 18, 15, 0.1));
      }
      .texto {
        position: absolute;
        z-index: 1;
        left: 80px;
        top: 50%;
        translate: 0 -50%;
        color: #f3eee4;
      }
      .serif {
        font-size: 64px;
        margin: 54px 0 14px;
        line-height: 1;
      }
      .pie {
        font: 700 15px/1 var(--sans);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #e0a84e;
        margin: 0;
      }
    </style>
  </body>
</html>
