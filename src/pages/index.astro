---
import Base from '../layouts/Base.astro';
import ObraCard from '../components/ObraCard.astro';
import Foto from '../components/Foto.astro';
import Logo from '../components/Logo.astro';
import Creditos from '../components/Creditos.astro';
import Escuchar from '../components/Escuchar.astro';
import { OBRA, CATEGORIAS, NOMBRES, type Categoria } from '../data/obra';
import simbolos from '../components/logo-simbolos.json';
import { DIRECTORES } from '../data/equipo';
import Asociados from '../components/Asociados.astro';

const fotogramas = [
  { img: 'mongolia-fotograma.jpg', pie: 'Los últimos nómadas de Mongolia · música y diseño sonoro de Martín Perea Tobón', pos: 'center 60%' },
  { img: '17IYYByXjKk.jpg', pie: 'Currulao y músicas del Pacífico Sur · Dial, 2026', pos: 'center 30%' },
  { img: '5lgpy6H5sTU.jpg', pie: 'Arrabal Gentío — Mangorito', pos: 'center' },
  { img: '4bftwkKm06U.jpg', pie: 'Tierra sin sol ni luna · música de Juan Rizoma', pos: 'center' },
];
const mongolia = OBRA.find((p) => p.id === 'mongolia')!;

const frentes = [
  {
    id: 'cine',
    titulo: 'Cine, series y documental',
    img: '6uWk6G-3VYs.jpg',
    texto: 'Música original, diseño sonoro y mezcla final. Llegamos cuando se escribe, cuando se filma o con el corte casi listo.',
    lista: ['Música original a la imagen', 'Diseño sonoro y foley', 'Mezcla para sala, TV y plataformas', 'Supervisión musical', 'Animación y videojuegos'],
    url: '/servicios#cine',
    ejemplo: ejemplo('bardo'),
  },
  {
    id: 'publicidad',
    titulo: 'Publicidad y marcas',
    img: 'FQ1OpRNI6bM.jpg',
    texto: 'Música y sonido para comerciales y campañas, con las versiones y los formatos que pide cada medio.',
    lista: ['Música original y jingles', 'Diseño sonoro', 'Identidad y logo sonoro', 'Cortes de 6 a 60 segundos', 'Locución y mezcla por medio'],
    url: '/publicidad',
    ejemplo: ejemplo('mazda-una-chispa'),
  },
  {
    id: 'sesiones',
    titulo: 'Artistas, sesiones y medios',
    img: 'W32TI7o8XM0.jpg',
    texto: 'Grabamos y filmamos sesiones en vivo, producimos discos y hacemos el sonido de podcasts y programas.',
    lista: ['Sesiones grabadas y filmadas', 'Producción y arreglos', 'Videoclips', 'Podcast y radio', 'Mezcla y masterización'],
    url: '/servicios#sesiones',
    ejemplo: ejemplo('noisesion'),
  },
];

const principal = OBRA.find((p) => p.id === 'currulao')!;
const pestanas: { id: string; texto: string }[] = [
  { id: 'destacadas', texto: 'Destacadas' },
  ...(['documental', 'cine', 'publicidad', 'sesiones', 'medios', 'discos'] as Categoria[]).map((c) => ({ id: c, texto: CATEGORIAS[c] })),
];
const enRejilla = OBRA.filter((p) => p.id !== 'currulao');
const inicial = enRejilla.filter((p) => p.destacada).slice(0, 6);
function ejemplo(id: string) {
  const p = OBRA.find((x) => x.id === id)!;
  return { yt: p.video!, titulo: p.titulo, credito: `${p.rol} — ${p.quien.map((q) => NOMBRES[q]).join(' y ')}` };
}
const partes = (simbolos as Record<string, any[]>).parabola;
const necesidades = [
  { texto: 'Una película', tema: 'cine' },
  { texto: 'Un documental', tema: 'cine' },
  { texto: 'Un comercial', tema: 'publicidad' },
  { texto: 'Una sesión en vivo', tema: 'sesiones' },
  { texto: 'Un podcast', tema: 'medios' },
  { texto: 'Un videojuego', tema: 'cine' },
];
---

<Base cabeceraSobreFoto>
  <!-- héroe -->
  <section class="heroe">
    <div class="heroe-fotos">
      {
        fotogramas.map((f, i) => (
          <figure class:list={['heroe-foto', { activa: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
            <Foto src={`obra/${f.img}`} sizes="100vw" anchos={[800, 1280, 1920]} prioridad={i === 0} posicion={f.pos} />
            <figcaption class="pie-foto">{f.pie}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="heroe-luz" aria-hidden="true"></div>
    <div class="envoltura heroe-texto">
      <div class="heroe-marca">
        <Logo modo="simbolo" tam={64} animado />
      </div>
      <p class="etq">Productora de música para medios audiovisuales</p>
      <h1>Música para <em>la imagen</em></h1>
      <p class="lead">
        Componemos, grabamos y mezclamos la música y el sonido de películas, documentales, series, comerciales y
        sesiones en vivo. Somos tres codirectores con una red de músicos asociados.
      </p>
      <div class="botones">
        <button
          class="boton lleno heroe-play"
          data-yt={mongolia.video}
          data-titulo={mongolia.titulo}
          data-credito={`${mongolia.rol} — Martín Perea Tobón · ${mongolia.ficha}`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
          Ver el corto
        </button>
        <a class="boton flecha" href="/obra">Toda la obra</a>
      </div>
      <div class="necesito">
        <p class="necesito-pregunta">¿Para qué necesitas música?</p>
        <div class="necesito-botones">
          {
            necesidades.map((n) => (
              <a class="chip" href={`/contacto?tema=${n.tema}&para=${encodeURIComponent(n.texto.toLowerCase())}`}>
                {n.texto}
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <a class="heroe-bajar" href="#hacemos" aria-label="Bajar a qué hacemos"><span></span></a>
  </section>

  <Creditos />

  <!-- qué hacemos (papel) -->
  <section class="seccion papel" id="hacemos">
    <div class="envoltura">
      <div class="cabeza-seccion rv">
        <div>
          <p class="etq">Qué hacemos</p>
          <h2>Del guion a la <em>mezcla final</em></h2>
        </div>
        <p class="lead">
          Una partitura para cuerdas, el ruido de una calle, un jingle de quince segundos o una banda grabada en vivo.
          Cada proyecto lo armamos con el equipo que haga falta.
        </p>
      </div>
      <div class="frentes">
        {
          frentes.map((fr, i) => (
            <article class="frente rv" style={`--d:${i * 0.08}s`}>
              <button
                class="frente-foto marco"
                data-yt={fr.ejemplo.yt}
                data-titulo={fr.ejemplo.titulo}
                data-credito={fr.ejemplo.credito}
                aria-label={`Ver un ejemplo: ${fr.ejemplo.titulo}`}
              >
                <Foto src={`obra/${fr.img}`} sizes="(max-width: 900px) 100vw, 33vw" />
                <span class="frente-ejemplo">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
                  Ver un ejemplo
                </span>
              </button>
              <h3>{fr.titulo}</h3>
              <p>{fr.texto}</p>
              <ul class="lista-raya">
                {fr.lista.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
              <div class="frente-acciones">
                <a class="boton flecha" href={fr.url}>Ver más</a>
                <a class="frente-pedir" href={`/contacto?tema=${fr.id}`}>Cotizar</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- obra -->
  <section class="seccion">
    <div class="envoltura">
      <div class="cabeza-seccion rv">
        <div>
          <p class="etq">Obra</p>
          <h2>Algunos trabajos</h2>
        </div>
        <p class="lead">
          Documentales, cortometrajes, animación, comerciales y sesiones. Cada pieza dice quién de nosotros la hizo y qué
          hizo.
        </p>
      </div>
      <div class="obra-principal rv">
        <ObraCard pieza={principal} grande />
      </div>
      <div class="pestanas" role="tablist" aria-label="Tipo de trabajo">
        {
          pestanas.map((t, i) => (
            <button class:list={['pestana', { activa: i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pestana={t.id}>
              {t.texto}
            </button>
          ))
        }
      </div>
      <div class="rejilla-obra" role="tabpanel">
        {
          enRejilla.map((p) => (
            <div class="celda-obra" data-cats={`${p.categoria}${p.destacada ? ' destacadas' : ''}`} hidden={!inicial.includes(p)}>
              <ObraCard pieza={p} />
            </div>
          ))
        }
      </div>
      <p class="ver-mas rv">
        <a class="boton flecha" href="/obra">Toda la obra · {OBRA.length} piezas</a>
      </p>
    </div>
  </section>

  <!-- escuchar -->
  <section class="seccion carbon" id="escuchar">
    <div class="envoltura">
      <div class="cabeza-seccion rv">
        <div>
          <p class="etq">Escuchar</p>
          <h2>Lo que suena cuando <em>no hay imagen</em></h2>
        </div>
        <p class="lead">
          Música propia de la casa: «Presagio», de Santiago, luci le y Martín; las aves de Santiago, y piezas de Martín
          entre el jazz y la música experimental. Dale play y sigue mirando el sitio.
        </p>
      </div>
      <Escuchar />
    </div>
  </section>

  <!-- el nombre (papel) -->
  <section class="seccion hueso fotofono">
    <div class="envoltura fotofono-rejilla">
      <figure class="fotofono-grabado rv">
        <Foto src="fotofono/transmisor.jpg" alt="Grabado de 1880: un hombre habla hacia el transmisor del fotófono, que refleja un rayo de sol." sizes="(max-width: 820px) 100vw, 50vw" />
        <figcaption class="pie-foto">El transmisor del fotófono · grabado de 1880</figcaption>
      </figure>
      <div class="fotofono-texto rv">
        <p class="etq">El nombre</p>
        <h2>Una voz que viajó en un <em>rayo de sol</em></h2>
        <p>
          En junio de 1880, Alexander Graham Bell y Charles Sumner Tainter mandaron una voz de un edificio a otro, en
          Washington, sin cables. El sonido hacía vibrar un espejo delgado, el espejo movía un rayo de sol y, a unos 200
          metros, un espejo parabólico con una celda de selenio volvía esa luz a sonido. Lo llamaron fotófono.
        </p>
        <p>Nuestro logo es ese espejo recibiendo la luz.</p>
        <div class="fotofono-juego">
          <svg class="espejo-vivo" viewBox="0 0 100 100" aria-hidden="true">
            {
              partes.map((q) =>
                q[0] === 'stroke' ? (
                  <path d={q[1]} fill="none" stroke="currentColor" stroke-width={q[2]} class={q[2] < 4 ? 'rayos' : 'espejo'} />
                ) : (
                  <circle cx={q[1][0]} cy={q[1][1]} r={q[1][2]} class="foco" />
                ),
              )
            }
            {partes.filter((q) => q[0] === 'stroke' && q[2] < 4).map((q) => <path d={q[1]} class="luz" pathLength="100" />)}
          </svg>
          <div>
            <button class="boton lleno encender" aria-pressed="false">Encender el sol</button>
            <p class="fotofono-nota">Así llegaba la voz al foco del espejo.</p>
          </div>
        </div>
        <a class="enlace" href="/fotofono">La historia completa</a>
      </div>
    </div>
  </section>

  <!-- equipo -->
  <section class="seccion">
    <div class="envoltura">
      <div class="cabeza-seccion rv">
        <div>
          <p class="etq">Codirección</p>
          <h2>Tres oficios, <em>una mesa</em></h2>
        </div>
        <p class="lead">
          Composición y arreglos, diseño sonoro, producción musical, ingeniería y realización audiovisual. Cada proyecto lo
          dirige quien más sabe de lo que pide.
        </p>
      </div>
      <div class="directores">
        {
          DIRECTORES.map((d, i) => (
            <a class="director rv" href={`/equipo#${d.id}`} style={`--d:${i * 0.08}s`}>
              <div class="director-foto">
                <Foto src={`equipo/${d.foto}`} alt={d.nombre} sizes="(max-width: 820px) 90vw, 30vw" anchos={[400, 640, 900]} />
              </div>
              <p class="director-rol">{d.rol}</p>
              <h3>{d.nombre}</h3>
              <p class="director-corta">{d.corta}</p>
              <span class="director-ver flecha">Ver perfil</span>
            </a>
          ))
        }
      </div>

      <div class="asociados rv">
        <div class="asociados-cabeza">
          <p class="etq">Músicos asociados</p>
          <p class="asociados-texto">
            Para cada proyecto convocamos a los intérpretes que pide la música: cuerdas, vientos, voces, percusiones,
            instrumentos tradicionales.
          </p>
          <a class="enlace" href="/equipo#asociados">Ver todos</a>
        </div>
        <Asociados />
      </div>
    </div>
  </section>

  <!-- publicidad (papel) -->
  <section class="seccion papel">
    <div class="envoltura publi">
      <div class="publi-texto rv">
        <p class="etq">Para agencias y marcas</p>
        <h2>Música para comerciales, <em>lista para la pauta</em></h2>
        <p class="lead">
          Versiones por duración, pistas separadas, mezcla para cada medio y una licencia de uso clara desde la propuesta.
        </p>
        <div class="botones">
          <a class="boton lleno flecha" href="/publicidad">Cómo trabajamos con marcas</a>
          <a class="boton" href="/contacto?tema=publicidad">Pedir una propuesta</a>
        </div>
      </div>
      <div class="publi-pieza rv">
        <ObraCard pieza={OBRA.find((p) => p.id === 'mazda-un-color')!} />
      </div>
    </div>
  </section>

  <!-- cierre sobre imagen -->
  <section class="cierre">
    <div class="cierre-fondo paralaje">
      <Foto src="obra/17IYYByXjKk.jpg" sizes="100vw" anchos={[800, 1280]} posicion="center 30%" />
    </div>
    <div class="envoltura cierre-caja rv">
      <p class="etq">Contacto</p>
      <h2>Cuéntanos qué estás <em>haciendo</em></h2>
      <p class="lead">
        Un guion, un corte, una referencia o una idea suelta sirven para empezar. Respondemos con preguntas, una propuesta
        y tiempos.
      </p>
      <div class="botones">
        <a class="boton lleno flecha" href="/contacto">Escribirnos</a>
      </div>
    </div>
  </section>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.heroe')) return;

    // luz que sigue el cursor en el héroe
    const heroe = document.querySelector<HTMLElement>('.heroe')!;
    if (matchMedia('(hover: hover)').matches) {
      heroe.addEventListener('pointermove', (e) => {
        const r = heroe.getBoundingClientRect();
        heroe.style.setProperty('--lx', `${e.clientX - r.left}px`);
        heroe.style.setProperty('--ly', `${e.clientY - r.top}px`);
        heroe.classList.add('con-luz');
      });
      heroe.addEventListener('pointerleave', () => heroe.classList.remove('con-luz'));
    }

    // pestañas de la obra
    const MAX = 6;
    const mostrar = (id: string) => {
      let n = 0;
      document.querySelectorAll<HTMLElement>('.celda-obra').forEach((c) => {
        const ok = (c.dataset.cats || '').split(' ').includes(id) && n < MAX;
        if (ok) n++;
        c.hidden = !ok;
        if (ok) {
          c.classList.remove('entra');
          void c.offsetWidth;
          c.classList.add('entra');
        }
      });
    };
    document.querySelectorAll<HTMLButtonElement>('.pestana').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll('.pestana').forEach((o) => {
          o.classList.toggle('activa', o === b);
          o.setAttribute('aria-selected', o === b ? 'true' : 'false');
        });
        mostrar(b.dataset.pestana!);
      }),
    );

    // encender el fotófono
    const boton = document.querySelector<HTMLButtonElement>('.encender');
    const juego = document.querySelector<HTMLElement>('.fotofono-juego');
    boton?.addEventListener('click', () => {
      const on = juego!.classList.toggle('encendido');
      boton.setAttribute('aria-pressed', on ? 'true' : 'false');
      boton.textContent = on ? 'Apagar' : 'Encender el sol';
    });

    const fotos = [...document.querySelectorAll<HTMLElement>('.heroe-foto')];
    if (fotos.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let i = 0;
    const t = setInterval(() => {
      if (!document.body.contains(fotos[0])) return clearInterval(t);
      fotos[i].classList.remove('activa');
      i = (i + 1) % fotos.length;
      fotos[i].classList.add('activa');
    }, 7000);
  });
</script>

<style>
  /* héroe */
  .heroe {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 9rem 0 clamp(5rem, 11vh, 8rem);
    overflow: hidden;
    background: var(--noche);
  }
  .heroe-fotos,
  .heroe-foto {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .heroe-foto {
    opacity: 0;
    transition: opacity 2.4s ease;
  }
  .heroe-foto.activa {
    opacity: 1;
  }
  .heroe-foto :global(picture),
  .heroe-foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .heroe-foto :global(img) {
    filter: saturate(0.85) contrast(1.04);
    scale: 1.08;
    transition: scale 9s linear;
  }
  .heroe-foto.activa :global(img) {
    scale: 1;
  }
  .heroe-fotos::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(20, 18, 15, 0.86) 0%, rgba(20, 18, 15, 0.5) 40%, rgba(20, 18, 15, 0) 72%),
      linear-gradient(0deg, rgba(20, 18, 15, 0.9) 0%, rgba(20, 18, 15, 0) 42%),
      linear-gradient(180deg, rgba(20, 18, 15, 0.55) 0%, rgba(20, 18, 15, 0) 22%);
  }
  .heroe-foto figcaption {
    position: absolute;
    right: var(--margen);
    bottom: 1.6rem;
    z-index: 1;
    text-align: right;
    max-width: 22rem;
  }
  .heroe-texto {
    position: relative;
    z-index: 2;
  }
  .heroe-luz {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle 340px at var(--lx, 50%) var(--ly, 50%), rgba(255, 228, 180, 0.16), transparent 70%);
    mix-blend-mode: screen;
    transition: opacity 0.6s var(--suave);
  }
  .con-luz .heroe-luz {
    opacity: 1;
  }
  .necesito {
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(243, 238, 228, 0.18);
    max-width: 44rem;
  }
  .necesito-pregunta {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
    margin: 0 0 0.8rem;
    color: rgba(243, 238, 228, 0.9);
  }
  .necesito-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    border: 1px solid rgba(243, 238, 228, 0.32);
    border-radius: 999px;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--plata);
    background: rgba(20, 18, 15, 0.35);
    backdrop-filter: blur(4px);
    transition:
      background 0.25s,
      color 0.25s,
      border-color 0.25s,
      translate 0.25s var(--suave);
  }
  .chip:hover {
    background: var(--sol);
    border-color: var(--sol);
    color: var(--tinta);
    translate: 0 -2px;
  }
  @media (max-width: 700px) {
    .necesito {
      margin-top: 2rem;
    }
  }
  .heroe-marca {
    color: var(--plata);
    margin-bottom: 1.8rem;
  }
  .heroe-texto h1 {
    max-width: 8em;
    margin-bottom: 1.6rem;
  }
  .heroe-texto .lead {
    max-width: 31em;
    color: rgba(243, 238, 228, 0.88);
  }
  .heroe-play svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .heroe-bajar {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    z-index: 2;
    width: 1px;
    height: 3.2rem;
    background: rgba(243, 238, 228, 0.25);
    overflow: hidden;
  }
  .heroe-bajar span {
    position: absolute;
    left: 0;
    width: 1px;
    height: 40%;
    background: var(--sol);
    animation: bajar 2.4s var(--suave) infinite;
  }
  @keyframes bajar {
    from {
      top: -40%;
    }
    to {
      top: 100%;
    }
  }
  @media (max-width: 700px) {
    .heroe-foto figcaption,
    .heroe-bajar {
      display: none;
    }
  }

  /* frentes */
  .frentes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.8rem);
  }
  .frente {
    display: flex;
    flex-direction: column;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--linea-papel);
  }
  .frente-foto {
    all: unset;
    position: relative;
    display: block;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 4 / 3;
    margin-bottom: 1.6rem;
    background: var(--grafito);
  }
  .frente-foto:focus-visible {
    outline: 2px solid var(--sol-tinta);
    outline-offset: 3px;
  }
  .frente-foto::after {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .frente-foto:hover::after {
    opacity: 1;
  }
  .frente-ejemplo {
