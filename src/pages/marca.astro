---
// Manual de marca de Fototoma. Es la fuente: el PDF sale de esta página con
// `node scripts/exportar-marca.mjs`. Si algo cambia en la marca, se cambia aquí.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Foto from '../components/Foto.astro';
import { CORREO } from '../data/equipo';
import simbolos from '../components/logo-simbolos.json';
const partes = (simbolos as Record<string, any[]>).parabola;

const VERSION = '1.0 · noviembre de 2026';

const colores = [
  { nombre: 'Noche', hex: '#14120F', uso: 'Fondo principal. Un negro cálido, nunca negro puro.', fondo: '#14120f', tinta: '#f3eee4' },
  { nombre: 'Carbón', hex: '#1C1915', uso: 'Fondo alterno para separar secciones oscuras.', fondo: '#1c1915', tinta: '#f3eee4' },
  { nombre: 'Plata', hex: '#F3EEE4', uso: 'Texto y logo sobre fondos oscuros.', fondo: '#f3eee4', tinta: '#14120f' },
  { nombre: 'Papel', hex: '#EFE9DD', uso: 'Fondo claro: servicios, publicidad, grabados.', fondo: '#efe9dd', tinta: '#14120f' },
  { nombre: 'Hueso', hex: '#F7F3EB', uso: 'Fondo claro alterno, para los grabados del fotófono.', fondo: '#f7f3eb', tinta: '#14120f' },
  { nombre: 'Tinta', hex: '#171512', uso: 'Texto y logo sobre fondos claros.', fondo: '#171512', tinta: '#f3eee4' },
  { nombre: 'Sol', hex: '#E0A84E', uso: 'El único acento: el foco, rótulos, un detalle por pantalla. Sobre oscuro.', fondo: '#e0a84e', tinta: '#14120f' },
  { nombre: 'Sol sobre papel', hex: '#9A6516', uso: 'El mismo acento cuando el fondo es claro.', fondo: '#9a6516', tinta: '#f7f3eb' },
];

const archivos = [
  ['Logo horizontal', 'fototoma-horizontal-negro / -blanco', 'SVG y PNG'],
  ['Logo apilado', 'fototoma-apilado-negro / -blanco', 'SVG y PNG'],
  ['Símbolo', 'fototoma-simbolo-negro / -blanco', 'SVG y PNG'],
  ['Foto de perfil para redes', 'fototoma-perfil-noche / -papel', 'PNG cuadrado'],
  ['Ícono del sitio', 'favicon.svg, favicon-32.png, apple-touch-icon.png', 'web'],
  ['Imagen para compartir', 'og.jpg (1200 × 630)', 'web'],
];
---

<Base titulo="Manual de marca" descripcion="Manual de marca de Fototoma Producciones." noindex>
  <article class="manual">
    <!-- portada -->
    <section class="hoja portada">
      <Logo modo="apilado" tam={230} />
      <div class="portada-pie">
        <p class="etq sin-haz">Manual de marca</p>
        <p>Versión {VERSION}</p>
      </div>
    </section>

    <!-- 1. la idea -->
    <section class="hoja papel-hoja">
      <div class="dos">
        <div>
          <p class="etq">1 · La idea</p>
          <h2>El receptor del fotófono</h2>
          <p>
            En 1880 Alexander Graham Bell y Charles Sumner Tainter transmitieron una voz en un rayo de sol. En el receptor,
            un espejo parabólico juntaba la luz en un punto, el foco, donde una celda de selenio la volvía sonido.
          </p>
          <p>
            El símbolo de Fototoma es ese espejo visto de lado: la curva, tres rayos que llegan paralelos y el foco. Es lo
            que hace la productora: recibir una imagen y devolverla con sonido.
          </p>
          <p>
            La marca es blanco y negro. El color lo ponen las imágenes de los trabajos; la marca solo agrega una luz, el
            sol, en pocos lugares.
          </p>
        </div>
        <figure class="grabado">
          <Foto src="fotofono/gartenlaube.jpg" sizes="50vw" anchos={[800, 1200]} alt="Esquema del fotófono, 1880." />
          <figcaption class="pie-foto">Esquema del fotófono · Die Gartenlaube, 1880. El espejo E y la celda D son el origen del símbolo.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. logo -->
    <section class="hoja">
      <p class="etq">2 · El logo</p>
      <h2>Tres versiones, dos tonos</h2>
      <p class="nota">
        La horizontal es la principal. La apilada va en piezas cuadradas o verticales y en cierres de video. El símbolo solo
        va cuando el nombre ya está cerca o el espacio es muy pequeño (ícono, foto de perfil, marca de agua).
      </p>
      <div class="lienzos">
        <div class="lienzo l-noche ancho"><Logo tam={86} /></div>
        <div class="lienzo l-papel ancho"><Logo tam={86} /></div>
        <div class="lienzo l-noche"><Logo modo="apilado" tam={120} /></div>
        <div class="lienzo l-papel"><Logo modo="apilado" tam={120} /></div>
        <div class="lienzo l-noche"><Logo modo="simbolo" tam={130} /></div>
        <div class="lienzo l-papel"><Logo modo="simbolo" tam={130} /></div>
      </div>
    </section>

    <!-- 3. construcción -->
    <section class="hoja papel-hoja">
      <p class="etq">3 · Construcción</p>
      <h2>Medidas del símbolo y del logotipo</h2>
      <div class="dos">
        <figure class="construccion">
          <svg viewBox="-12 -12 124 124" aria-label="Construcción del símbolo con sus guías">
            <g stroke="#9a6516" stroke-width="0.35" fill="none">
              <rect x="0" y="0" width="100" height="100" stroke-dasharray="1.5 1.5" />
              <line x1="-6" y1="50" x2="106" y2="50" stroke-dasharray="1 1.5" />
              <line x1="-6" y1="29" x2="106" y2="29" stroke-dasharray="1 1.5" />
              <line x1="-6" y1="71" x2="106" y2="71" stroke-dasharray="1 1.5" />
              <line x1="14" y1="-6" x2="14" y2="106" stroke-dasharray="1 1.5" />
              <line x1="21.14" y1="-6" x2="21.14" y2="106" stroke-dasharray="1 1.5" />
              <line x1="70" y1="-6" x2="70" y2="106" stroke-dasharray="1 1.5" />
            </g>
            {
              partes.map((p) =>
                p[0] === 'stroke' ? (
                  <path d={p[1]} fill="none" stroke="#171512" stroke-width={p[2]} />
                ) : (
                  <circle cx={p[1][0]} cy={p[1][1]} r={p[1][2]} fill="#171512" />
                ),
              )
            }
            <g font-family="Lato, sans-serif" font-size="3.2" fill="#9a6516">
              <text x="14" y="-7.5" text-anchor="middle">x 14</text>
              <text x="21.14" y="111" text-anchor="middle">foco 21,1</text>
              <text x="70" y="-7.5" text-anchor="middle">x 70</text>
              <text x="107" y="30">29</text>
              <text x="107" y="51">50</text>
              <text x="107" y="72">71</text>
            </g>
          </svg>
        </figure>
        <div>
          <dl class="medidas">
            <div><dt>Caja</dt><dd>100 × 100 unidades. Todo se mide en esa caja.</dd></div>
            <div><dt>Espejo</dt><dd>Parábola abierta a la derecha, de 80 de alto, vértice en x = 14 y borde en x = 70. Trazo de 6,4.</dd></div>
            <div><dt>Foco</dt><dd>En x ≈ 21,1, centro vertical. Círculo de radio 4,6. Es el foco real de la parábola.</dd></div>
            <div><dt>Rayos</dt><dd>Tres horizontales que entran desde x = 98, a 21 unidades uno del otro. Trazo de 2,6. Los de afuera no tocan el espejo; el del centro no toca el foco.</dd></div>
            <div><dt>Logotipo</dt><dd>«FOTOTOMA» en Newsreader, versales, interletra 0,16 em. «PRODUCCIONES» en Lato negrita, interletra 0,62 em, centrada bajo la palabra y a un cuarto de su tamaño.</dd></div>
            <div><dt>Horizontal</dt><dd>El símbolo mide 1,75 veces el alto de las versales y va separado por un tercio de su propio alto.</dd></div>
          </dl>
          <p class="nota">Las medidas exactas están en <code>scripts/generar-logo.py</code>. Para cambiar el logo se cambia ese archivo, nunca los SVG a mano.</p>
        </div>
      </div>
    </section>

    <!-- 4. uso -->
    <section class="hoja">
      <p class="etq">4 · Uso</p>
      <h2>Espacio, tamaños y lo que no se hace</h2>
      <div class="tres">
        <div>
          <h3>Área de respeto</h3>
          <div class="respeto"><Logo tam={40} /></div>
          <p>Alrededor del logo queda libre, como mínimo, la mitad del alto del símbolo. Nada de texto, bordes o cortes de imagen dentro de esa zona.</p>
        </div>
        <div>
          <h3>Tamaños mínimos</h3>
          <div class="minimos">
            <span><Logo tam={30} /><small>Horizontal: 120 px · 30 mm de ancho</small></span>
            <span><Logo modo="simbolo" tam={16} /><small>Símbolo: 16 px · 5 mm</small></span>
          </div>
          <p>Por debajo de eso el «PRODUCCIONES» deja de leerse: se usa el símbolo solo.</p>
        </div>
        <div>
          <h3>Sobre fotos</h3>
          <div class="sobre-foto marco">
            <Foto src="obra/2xwhnGZxArw.jpg" sizes="30vw" anchos={[480, 800]} />
            <span class="sobre-foto-logo"><Logo tam={40} /></span>
          </div>
          <p>En plata, sobre una zona oscura y tranquila de la imagen, o con un velo de noche al 60 % debajo.</p>
        </div>
      </div>
      <h3 class="no-titulo">No se hace</h3>
      <div class="noes">
        <figure><span class="mal"><span style="display:inline-block;color:#e0a84e"><Logo tam={34} /></span></span><figcaption>Cambiar el color</figcaption></figure>
        <figure><span class="mal"><span style="display:inline-block;transform:scaleX(1.4)"><Logo tam={34} /></span></span><figcaption>Estirar o deformar</figcaption></figure>
        <figure><span class="mal"><span style="display:inline-block;transform:rotate(-12deg)"><Logo tam={34} /></span></span><figcaption>Rotar</figcaption></figure>
        <figure><span class="mal"><span style="display:inline-block;filter:drop-shadow(4px 4px 3px #000)"><Logo tam={34} /></span></span><figcaption>Sombras, brillos o degradados</figcaption></figure>
        <figure><span class="mal mal-letra"><Logo tam={34} /></span><figcaption>Cambiar la letra</figcaption></figure>
        <figure><span class="mal mal-fondo"><Logo tam={34} /></span><figcaption>Fondos sin contraste</figcaption></figure>
      </div>
    </section>

    <!-- 5. color -->
    <section class="hoja papel-hoja">
      <p class="etq">5 · Color</p>
      <h2>Noche, papel y una sola luz</h2>
      <p class="nota">
        Las secciones alternan noche y papel: la sala oscura y el papel de los grabados. El sol aparece poco: en el foco de
        los rótulos, en un enlace, en el botón al pasar el mouse. Si hay sol en todo, deja de ser luz.
      </p>
      <div class="colores">
        {
          colores.map((c) => (
            <div class="color">
              <div class="muestra" style={`background:${c.fondo};color:${c.tinta}`}>
                <span>{c.nombre}</span>
              </div>
              <p class="hex">{c.hex}</p>
              <p class="uso">{c.uso}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 6. tipografía -->
    <section class="hoja">
      <p class="etq">6 · Tipografía</p>
      <h2>Newsreader y Lato</h2>
      <div class="dos">
        <div class="tipo">
          <p class="tipo-muestra serif">Aa</p>
          <h3>Newsreader</h3>
          <p>Serif de periódico con tamaño óptico. Para titulares, el logotipo, los nombres y los pies de foto (en cursiva). En titulares, peso 400 y una palabra en cursiva cuando ayuda al sentido.</p>
          <p class="nota">Libre, Google Fonts · en el sitio: @fontsource-variable/newsreader</p>
        </div>
        <div class="tipo">
          <p class="tipo-muestra lato">Aa</p>
          <h3>Lato</h3>
          <p>Sans para el texto corrido (400) y los rótulos (700, versales, interletra 0,16–0,18 em). Nunca titulares en Lato.</p>
          <p class="nota">Libre, Google Fonts · en el sitio: @fontsource/lato</p>
        </div>
      </div>
      <div class="escala">
        <p class="etq">Rótulo · Lato 700 versales</p>
        <p class="esc-h1 serif">Música para <em>la imagen</em></p>
        <p class="esc-h2 serif">Titular de sección · Newsreader 400</p>
        <p class="esc-lead">Entradilla · Lato 400 a 1,25 rem, para abrir una sección en dos o tres líneas.</p>
        <p>Texto · Lato 400 a 17 px con interlineado 1,6. Frases cortas y concretas.</p>
        <p class="pie-foto">Pie de foto · Newsreader cursiva · Título de la obra · crédito</p>
      </div>
    </section>

    <!-- 7. elementos -->
    <section class="hoja papel-hoja">
      <p class="etq">7 · Elementos</p>
      <h2>Piezas que se repiten</h2>
      <div class="tres">
        <div>
          <h3>El haz</h3>
          <p class="etq">Así empieza un rótulo</p>
          <p>Una línea fina que termina en un punto: un rayo llegando al foco. Va antes de cada rótulo de sección. No se usa como adorno suelto.</p>
        </div>
        <div>
          <h3>Pie de foto</h3>
          <div class="marco pie-demo">
            <Foto src="obra/17IYYByXjKk.jpg" sizes="30vw" anchos={[480, 800]} />
            <span class="pie pie-foto">Currulao y músicas del Pacífico Sur · Dial, 2026</span>
          </div>
          <p>Abajo a la izquierda, sobre un velo suave. Título de la obra · crédito. Toda imagen de un trabajo lleva su pie.</p>
        </div>
        <div>
          <h3>Botones</h3>
          <div class="botones-demo">
            <span class="boton lleno flecha">Pedir una propuesta</span>
            <span class="boton">Qué entregamos</span>
          </div>
          <p>Esquinas rectas, versales, borde de 1 px. El lleno es la acción principal; uno por bloque.</p>
        </div>
      </div>
    </section>

    <!-- 8. imagen y textos -->
    <section class="hoja">
      <div class="dos">
        <div>
          <p class="etq">8 · Imagen</p>
          <h2>Fotogramas reales</h2>
          <p>
            Las imágenes son de los trabajos de Fototoma y de sus integrantes, a color, como salieron del color final. Sin
            filtros, sin bancos de imágenes, sin collages. Los retratos del equipo van a color y en 4:5.
          </p>
          <p>El tono de referencia es documental: luz natural, gente en su lugar, figura pequeña en paisaje grande.</p>
        </div>
        <div>
          <p class="etq">9 · Textos</p>
          <h2>Llano y concreto</h2>
          <p>Decir qué se hace, para quién y cómo. Frases cortas. Nombres propios y datos verificables.</p>
          <ul class="lista-raya sino">
            <li>Sí: «Componemos, grabamos y mezclamos la música de películas y comerciales.»</li>
            <li>No: fórmulas como «no hacemos música, hacemos emociones», listas de tres por ritmo ni frases de cierre redondas.</li>
            <li>Tuteo, español de Colombia. Cada pieza de la obra dice quién la hizo y qué hizo.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 10. archivos -->
    <section class="hoja papel-hoja">
      <p class="etq">10 · Archivos</p>
      <h2>Dónde están y cómo se rehacen</h2>
      <table class="tabla">
        <thead><tr><th>Pieza</th><th>Archivo</th><th>Formato</th></tr></thead>
        <tbody>
          {archivos.map((a) => <tr>{a.map((c) => <td>{c}</td>)}</tr>)}
        </tbody>
      </table>
      <ol class="pasos-repro">
        <li>Todo vive en <code>D:\Fototoma</code>: el sitio en <code>web</code>, los archivos de marca en <code>Marca</code>.</li>
        <li>Si cambia el logo: editar <code>scripts/generar-logo.py</code> y correr <code>python -I scripts/generar-logo.py</code>.</li>
        <li>Para sacar PNG, íconos, imagen para compartir y este PDF: con el sitio corriendo (<code>npm run dev</code>), correr <code>npm run marca</code>.</li>
        <li>Si cambia un color o una regla: cambiar esta página (<code>src/pages/marca.astro</code>) y <code>src/styles/global.css</code>, y volver a exportar.</li>
      </ol>
      <p class="nota">Contacto: {CORREO}</p>
    </section>
  </article>
</Base>

<style>
  .manual {
    background: var(--noche);
  }
  .hoja {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 6.5rem) var(--margen);
    border-bottom: 1px solid var(--linea);
  }
  .papel-hoja {
    max-width: none;
    background: var(--papel);
    color: var(--tinta);
    --linea: var(--linea-papel);
    --plata-2: var(--tinta-2);
    --gris: #7d766b;
    padding-inline: max(var(--margen), calc((100% - 1180px) / 2 + var(--margen)));
  }
  .papel-hoja .etq::before {
    background:
      radial-gradient(circle at calc(100% - 2.5px) 50%, var(--sol-tinta) 2.4px, transparent 2.9px),
      linear-gradient(var(--sol-tinta), var(--sol-tinta)) left center / calc(100% - 7px) 1px no-repeat;
  }
  .hoja h2 {
    margin-bottom: 1.6rem;
  }
  .hoja h3 {
    font-size: 1.35rem;
    margin-bottom: 0.8rem;
  }
  .hoja p {
    color: var(--plata-2);
    max-width: 40em;
  }
  .nota {
    font-size: 0.92rem;
    color: var(--gris) !important;
  }
  code {
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.88em;
    background: rgba(127, 120, 108, 0.16);
    padding: 0.1em 0.35em;
  }
  .portada {
    min-height: 82vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4rem;
    text-align: center;
  }
  .portada-pie p {
    margin: 0 auto 0.3rem;
  }
  .dos {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem 4.5rem;
    align-items: start;
  }
  .tres {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }
  @media (max-width: 860px) {
    .dos,
    .tres {
      grid-template-columns: 1fr;
    }
  }
  .grabado {
    margin: 0;
  }
  .grabado :global(img) {
    mix-blend-mode: multiply;
    filter: grayscale(1) contrast(1.12);
  }
  .grabado figcaption {
    margin-top: 0.6rem;
    color: var(--tinta-2);
  }

  .lienzos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }
  .lienzo {
    min-height: 260px;
    display: grid;
    place-items: center;
    padding: 2rem;
  }
  .l-noche {
    background: #14120f;
    color: #f3eee4;
    border: 1px solid var(--linea);
  }
  .l-papel {
    background: #efe9dd;
    color: #171512;
  }

  .construccion {
    margin: 0;
    position: relative;
    aspect-ratio: 1;
    background: var(--hueso);
    color: var(--tinta);
  }
  .construccion > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .medidas {
    margin: 0 0 1.5rem;
  }
  .medidas div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--linea);
  }
  .medidas dt {
    font-family: var(--serif);
    font-size: 1.15rem;
  }
  .medidas dd {
    margin: 0;
    color: var(--tinta-2);
    font-size: 0.95rem;
  }

  .respeto {
    display: inline-block;
    max-width: 100%;
    padding: 20px;
    outline: 1px dashed var(--sol);
    outline-offset: -1px;
    background:
      linear-gradient(var(--noche), var(--noche)) content-box,
      repeating-linear-gradient(45deg, rgba(224, 168, 78, 0.18) 0 2px, transparent 2px 8px);
    margin-bottom: 1rem;
  }
  .minimos {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .minimos span {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .minimos small {
    color: var(--gris);
  }
  .sobre-foto {
    aspect-ratio: 16 / 9;
    margin-bottom: 1rem;
  }
  .sobre-foto-logo {
    position: absolute;
    left: 1rem;
    top: 1rem;
    z-index: 2;
    color: var(--plata);
  }
  .no-titulo {
    margin-top: 3.5rem;
  }
  .noes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .noes figure {
    margin: 0;
  }
  .mal {
    position: relative;
    display: grid;
    place-items: center;
    height: 130px;
    border: 1px solid var(--linea);
    overflow: hidden;
  }
  .noes figure > span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top right, transparent calc(50% - 1px), #c0442a calc(50% - 1px), #c0442a calc(50% + 1px), transparent calc(50% + 1px));
    opacity: 0.8;
  }
  .mal-letra :global(.logo-marca) {
    font-family: Impact, 'Arial Black', sans-serif;
    letter-spacing: 0;
  }
  .mal-fondo {
    background: #5a544b;
    color: #7d766b;
  }
  .noes figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--plata-2);
  }
  @media (max-width: 760px) {
    .noes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .colores {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin-top: 2rem;
  }
  .muestra {
