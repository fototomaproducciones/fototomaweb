---
import Base from '../../layouts/Base.astro';
import { CORREO } from '../../data/equipo';
import { IDIOMAS, idioma, enlace, juntar } from '../../i18n';

export function getStaticPaths() {
  return IDIOMAS();
}
const lang = idioma(Astro.url);
const en = lang === 'en';
const u = (r: string) => enlace(lang, r);
const dev = import.meta.env.DEV;
const temas = en
  ? [
      { id: 'cine', texto: 'Film, series or documentary' },
      { id: 'publicidad', texto: 'Commercial or campaign' },
      { id: 'sesiones', texto: 'Live session, album or music video' },
      { id: 'medios', texto: 'Podcast, radio or show' },
      { id: 'musico', texto: 'I’m a musician and want to join' },
      { id: 'otro', texto: 'Something else' },
    ]
  : [
  { id: 'cine', texto: 'Película, serie o documental' },
  { id: 'publicidad', texto: 'Comercial o campaña' },
  { id: 'sesiones', texto: 'Sesión en vivo, disco o videoclip' },
  { id: 'medios', texto: 'Podcast, radio o programa' },
  { id: 'musico', texto: 'Soy músico y quiero sumarme' },
  { id: 'otro', texto: 'Otra cosa' },
    ];
// textos del formulario que arma el correo
const F = en
  ? {
      necesito: 'I need music for',
      falta: 'Your name, your email or the message is missing.',
      abierto: 'Your email app opened with the message ready to send.',
      nombre: 'Name',
      correo: 'Email',
      empresa: 'Company or project',
      tema: 'Topic',
      material: 'Material',
    }
  : {
      necesito: 'Necesito música para',
      falta: 'Falta tu nombre, tu correo o el mensaje.',
      abierto: 'Se abrió tu programa de correo con el mensaje listo para enviar.',
      nombre: 'Nombre',
      correo: 'Correo',
      empresa: 'Empresa o proyecto',
      tema: 'Tema',
      material: 'Material',
    };
---

<Base
  titulo={en ? 'Contact' : 'Contacto'}
  descripcion={
    en
      ? 'Write to Fototoma Producciones: tell us about your film, series, documentary, commercial or session.'
      : 'Escríbele a Fototoma Producciones: cuéntanos tu película, serie, documental, comercial o sesión.'
  }
>
  <section class="seccion">
    <div class="envoltura contacto">
      <div>
        <p class="etq">{en ? 'Contact' : 'Contacto'}</p>
        <h1>{en ? 'Tell us what you are making' : 'Cuéntanos qué estás haciendo'}</h1>
        <p class="lead">
          {
            en
              ? 'A script, a cut, a reference or a loose idea is enough to start. We’ll reply with questions, a proposal and a timeline. We write in Spanish and English.'
              : 'Un guion, un corte, una referencia o una idea suelta sirven para empezar. Te respondemos con preguntas, una propuesta y tiempos.'
          }
        </p>
        <div class="directo">
          <p class="etq">{en ? 'Direct' : 'Directo'}</p>
          <a class="correo enlace" href={`mailto:${CORREO}`}>{CORREO}</a>
        </div>
      </div>

      <form class="formulario" id="formulario" novalidate>
        <label>
          <span>{F.nombre}</span>
          <input name="nombre" autocomplete="name" required />
        </label>
        <label>
          <span>{F.correo}</span>
          <input name="correo" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>{F.empresa} <em>{en ? '(optional)' : '(opcional)'}</em></span>
          <input name="empresa" autocomplete="organization" />
        </label>
        <fieldset>
          <legend>{en ? 'What is it about?' : '¿De qué se trata?'}</legend>
          <div class="temas">
            {
              temas.map((t, i) => (
                <label class="tema">
                  <input type="radio" name="tema" value={t.texto} data-id={t.id} checked={i === 0} />
                  <span>{t.texto}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <label>
          <span>{en ? 'Tell us' : 'Cuéntanos'}</span>
          <textarea
            name="mensaje"
            rows="6"
            required
            placeholder={en ? 'What it is, what stage it’s at, when you need it…' : 'Qué es, en qué etapa va, para cuándo lo necesitas…'}
          ></textarea>
        </label>
        <label>
          <span>{en ? 'Link to material' : 'Enlace a material'} <em>{en ? '(optional)' : '(opcional)'}</em></span>
          <input name="enlace" type="url" placeholder={en ? 'Script, cut, references…' : 'Guion, corte, referencias…'} />
        </label>
        <button class="boton lleno flecha" type="submit">{en ? 'Send' : 'Enviar'}</button>
        <p class="nota" aria-live="polite"></p>
        {dev && <p class="pendiente">PENDIENTE: por ahora el formulario abre el correo; conectar envío directo al publicar</p>}
      </form>
    </div>
  </section>
</Base>

<script define:vars={{ CORREO, F }}>
  const form = document.getElementById('formulario');
  const params = new URLSearchParams(location.search);
  const tema = params.get('tema');
  if (tema) {
    const r = form.querySelector(`input[data-id="${tema}"]`);
    if (r) r.checked = true;
  }
  const para = params.get('para');
  if (para) form.querySelector('textarea').value = `${F.necesito} ${para}. `;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const nota = form.querySelector('.nota');
    if (!form.checkValidity()) {
      nota.textContent = F.falta;
      form.reportValidity();
      return;
    }
    const d = new FormData(form);
    const asunto = `${d.get('tema')} — ${d.get('nombre')}`;
    const cuerpo = [
      `${F.nombre}: ${d.get('nombre')}`,
      `${F.correo}: ${d.get('correo')}`,
      d.get('empresa') ? `${F.empresa}: ${d.get('empresa')}` : '',
      `${F.tema}: ${d.get('tema')}`,
      '',
      d.get('mensaje'),
      d.get('enlace') ? `\n${F.material}: ${d.get('enlace')}` : '',
    ]
      .filter((x) => x !== '')
      .join('\n');
    location.href = `mailto:${CORREO}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
    nota.textContent = F.abierto;
  });
</script>

<style>
  .contacto {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 3rem 6rem;
    align-items: start;
  }
  h1 {
    margin-bottom: 1.6rem;
    max-width: 9em;
  }
  .directo {
    margin-top: 3rem;
  }
  .correo {
    overflow-wrap: anywhere;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .formulario {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .formulario label:not(.tema) > span,
  legend {
    display: block;
    font-size: var(--t-etq);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gris);
    margin-bottom: 0.5rem;
  }
  .formulario em {
    font-style: normal;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }
  input:not([type='radio']),
  textarea {
    width: 100%;
    font: inherit;
    color: var(--plata);
    background: transparent;
    border-radius: 0;
    border: 0;
    border-bottom: 1px solid var(--linea);
    padding: 0.6rem 0;
    outline: none;
    transition: border-color 0.2s;
    resize: vertical;
  }
  input:focus,
  textarea:focus {
    border-color: var(--plata);
  }
  input::placeholder,
  textarea::placeholder {
    color: #5f5c56;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .temas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tema {
    cursor: pointer;
  }
  .tema input {
    position: absolute;
    opacity: 0;
  }
  .tema span {
    display: inline-block;
    font-size: 0.9rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--linea);
    color: var(--plata-2);
    transition: all 0.2s;
  }
  .tema input:checked + span {
    background: var(--plata);
    border-color: var(--plata);
    color: var(--noche);
  }
  .tema input:focus-visible + span {
    outline: 2px solid var(--plata);
    outline-offset: 2px;
  }
  .formulario .boton {
    align-self: flex-start;
    margin-top: 0.6rem;
  }
  .nota {
    color: var(--plata-2);
    min-height: 1.5em;
    margin: 0;
  }
  @media (max-width: 860px) {
    .contacto {
      grid-template-columns: 1fr;
    }
  }
</style>
