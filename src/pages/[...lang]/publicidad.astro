---
import Base from '../../layouts/Base.astro';
import ObraCard from '../../components/ObraCard.astro';
import { OBRA } from '../../data/obra';
import { IDIOMAS, idioma, enlace, juntar } from '../../i18n';

export function getStaticPaths() {
  return IDIOMAS();
}
const lang = idioma(Astro.url);
const en = lang === 'en';
const u = (r: string) => enlace(lang, r);

const muestras = OBRA.filter((p) => p.categoria === 'publicidad');

const ENTREGABLES_ES = [
  {
    nombre: 'Música original',
    texto: 'Compuesta para la idea y el ritmo del corte. Si la campaña lo pide, jingle con letra y voces.',
  },
  {
    nombre: 'Diseño sonoro',
    texto: 'Sonido de producto, transiciones, ambientes y efectos, hechos a la medida de cada plano.',
  },
  {
    nombre: 'Versiones por duración',
    texto: 'La misma pieza resuelta en 6, 10, 15, 20, 30 y 60 segundos, sin cortes bruscos en ninguna.',
  },
  {
    nombre: 'Mezcla para cada medio',
    texto: 'Televisión, sala de cine, radio, plataformas y redes, cada una con la sonoridad que exige.',
  },
  {
    nombre: 'Pistas separadas',
    texto: 'Música, efectos y voces por aparte, para que la posproducción pueda hacer ajustes de última hora.',
  },
  {
    nombre: 'Identidad sonora',
    texto: 'Logo sonoro y una paleta de música para que la marca suene igual en un comercial, un pódcast o un evento.',
  },
  {
    nombre: 'Locución',
    texto: 'Grabación y dirección de voces. Juan es locutor y trabajamos con voces asociadas.',
  },
  {
    nombre: 'Licencia clara',
    texto: 'Por escrito desde la propuesta: medios, territorio y tiempo de uso, o cesión total de derechos.',
  },
];

const PIEZAS_ES = [
  'Comerciales para televisión y cine',
  'Campañas para redes y plataformas',
  'Campañas institucionales y de entidades públicas',
  'Video corporativo y de producto',
  'Eventos, lanzamientos y activaciones',
  'Cuñas de radio',
];

const PASOS_ES = [
  { nombre: 'Brief', texto: 'Idea, guion o animatic, referencias y medios donde va a salir.' },
  { nombre: 'Maquetas', texto: 'Dos o tres direcciones cortas sobre la imagen para escoger el tono.' },
  { nombre: 'Producción', texto: 'Grabamos con los músicos que pida la pieza y hacemos el diseño sonoro.' },
  { nombre: 'Ajuste al corte final', texto: 'Seguimos los cambios de montaje hasta que el corte quede cerrado.' },
  { nombre: 'Entrega', texto: 'Versiones, mezclas, pistas separadas y la licencia firmada.' },
];

const COTIZAR_ES = [
  'Cuántas piezas y de qué duración',
  'Dónde y por cuánto tiempo van a circular',
  'Si hay voces, letra o locución',
  'Referencias de música o de sonido',
  'La fecha de entrega',
];
const ENTREGABLES_EN: typeof ENTREGABLES_ES = [
  { nombre: 'Original music', texto: 'Written for the idea and the rhythm of the cut. If the campaign calls for it, a jingle with lyrics and vocals.' },
  { nombre: 'Sound design', texto: 'Product sounds, transitions, ambiences and effects, made to fit every shot.' },
  { nombre: 'Cutdowns by length', texto: 'The same piece resolved in 6, 10, 15, 20, 30 and 60 seconds, with no abrupt edits in any of them.' },
  { nombre: 'A mix for each medium', texto: 'Television, cinema, radio, streaming and social media, each with the loudness and sound it requires.' },
  { nombre: 'Stems', texto: 'Music, effects and voices delivered separately, so post-production can make last-minute changes.' },
  { nombre: 'Sonic identity', texto: 'A sound logo and a music palette so the brand sounds the same in a commercial, a podcast or an event.' },
  { nombre: 'Voice-over', texto: 'Voice recording and direction. Juan is a radio host, and we work with associate voice talent.' },
  { nombre: 'Clear licensing', texto: 'In writing from the proposal: media, territory and term of use, or a full buyout of rights.' },
];
const entregables = en ? ENTREGABLES_EN : ENTREGABLES_ES;
const piezas = en
  ? [
      'TV and cinema commercials',
      'Social media and streaming campaigns',
      'Institutional and public-sector campaigns',
      'Corporate and product videos',
      'Events, launches and activations',
      'Radio spots',
    ]
  : PIEZAS_ES;
const PASOS_EN: typeof PASOS_ES = [
  { nombre: 'Brief', texto: 'Idea, script or animatic, references and the media where it will run.' },
  { nombre: 'Demos', texto: 'Two or three short directions over the picture to choose the tone.' },
  { nombre: 'Production', texto: 'We record with the musicians the piece needs and do the sound design.' },
  { nombre: 'Conforming to the final cut', texto: 'We follow the editing changes until the cut is locked.' },
  { nombre: 'Delivery', texto: 'Cutdowns, mixes, stems and the signed license.' },
];
const pasos = en ? PASOS_EN : PASOS_ES;
const cotizar = en
  ? [
      'How many pieces, and how long',
      'Where and for how long they will run',
      'Whether there are vocals, lyrics or voice-over',
      'Music or sound references',
      'The delivery date',
    ]
  : COTIZAR_ES;

---

<Base
  titulo={en ? 'Advertising' : 'Publicidad'}
  descripcion={
    en
      ? 'Original music, jingles, sound design, sonic identity and mixing for commercials, campaigns and branded content.'
      : 'Música original, jingles, diseño sonoro, identidad sonora y mezcla para comerciales, campañas y contenido de marca.'
  }
>
  <div class="papel">
    <section class="seccion publi-heroe">
      <div class="envoltura heroe-rejilla">
        <div>
          <p class="etq">{en ? 'Advertising and brands' : 'Publicidad y marcas'}</p>
          <h1>{en ? 'Music and sound for commercials' : 'Música y sonido para comerciales'}</h1>
          <p class="lead">
            {
              en
                ? 'We compose for the idea behind the campaign, record with real musicians and deliver what the media plan needs: cutdowns by length, mixes for each medium, stems and a clear license.'
                : 'Componemos para la idea de la campaña, grabamos con músicos reales y entregamos lo que pide la pauta: versiones por duración, mezclas por medio, pistas separadas y una licencia clara.'
            }
          </p>
          <div class="botones">
            <a class="boton lleno flecha" href={u('/contacto?tema=publicidad')}>{en ? 'Request a proposal' : 'Pedir una propuesta'}</a>
            <a class="boton" href="#entregables">{en ? 'What we deliver' : 'Qué entregamos'}</a>
          </div>
        </div>
        <ul class="tipos rv">
          {piezas.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </section>

    <section class="seccion muestras">
      <div class="envoltura">
        <p class="etq rv">{en ? 'Samples' : 'Muestras'}</p>
        <div class="muestras-rejilla">
          {
            muestras.map((p) => (
              <div class="rv">
                <ObraCard pieza={p} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="seccion" id="entregables">
      <div class="envoltura">
        <div class="cabeza-seccion rv">
          <div>
            <p class="etq">{en ? 'What we deliver' : 'Qué entregamos'}</p>
            <h2>{en ? 'Everything post-production needs' : 'Todo lo que necesita la posproducción'}</h2>
          </div>
          <p class="lead">
            {
              en
                ? 'An ad doesn’t end with the music: it has to work in several lengths, in several media, and with changes up to the last day.'
                : 'Una pieza de publicidad no termina en la música: tiene que funcionar en varias duraciones, en varios medios y con cambios hasta el último día.'
            }
          </p>
        </div>
        <dl class="entregables">
          {
            entregables.map((e) => (
              <div class="entregable rv">
                <dt>{e.nombre}</dt>
                <dd>{e.texto}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="seccion">
      <div class="envoltura proceso">
        <div class="rv">
          <p class="etq">{en ? 'How we work' : 'Cómo trabajamos'}</p>
          <h2>{en ? 'From brief to delivery' : 'Del brief a la entrega'}</h2>
        </div>
        <ol class="linea">
          {
            pasos.map((p) => (
              <li class="rv">
                <h3>{p.nombre}</h3>
                <p>{p.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="seccion cotizar">
      <div class="envoltura cotizar-rejilla">
        <div class="rv">
          <p class="etq">{en ? 'To get a quote' : 'Para cotizar'}</p>
          <h2>{en ? 'Tell us this and we’ll send you a proposal' : 'Cuéntanos esto y te mandamos una propuesta'}</h2>
          <p class="lead">
            {
              en
                ? 'No fixed rates: the fee depends on length, media, how long it runs and which musicians we need to bring in.'
                : 'Sin precios fijos: el valor depende de la duración, los medios, el tiempo de pauta y los músicos que haga falta convocar.'
            }
          </p>
          <a class="boton lleno flecha" href={u('/contacto?tema=publicidad')}>{en ? 'Write to us' : 'Escribirnos'}</a>
        </div>
        <ul class="lista-cotizar rv">
          {cotizar.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .papel {
    background: var(--papel);
  }
  .papel .seccion + .seccion {
    border-top: 1px solid var(--linea-papel);
  }
  .heroe-rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem 5rem;
    align-items: end;
  }
  h1 {
    margin-bottom: 1.6rem;
    max-width: 9em;
  }
  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }
  .tipos {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--tinta);
  }
  .tipos li {
    font-family: var(--serif);
    font-size: 1.2rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--linea-papel);
  }
  @media (max-width: 860px) {
    .heroe-rejilla {
      grid-template-columns: 1fr;
    }
  }

  .muestras-rejilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }
  @media (max-width: 700px) {
    .muestras-rejilla {
      grid-template-columns: 1fr;
    }
  }

  .entregables {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 2rem;
    margin: 0;
  }
  .entregable {
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--tinta);
  }
  .entregable dt {
    font-family: var(--serif);
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }
  .entregable dd {
    margin: 0;
    color: var(--tinta-2);
    font-size: 0.97rem;
  }
  @media (max-width: 980px) {
    .entregables {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .entregables {
      grid-template-columns: 1fr;
    }
  }

  .proceso {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 3rem;
  }
  .linea {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .linea li {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: 1rem 2rem;
    padding: 1.3rem 0;
    border-top: 1px solid var(--linea-papel);
  }
  .linea li:last-child {
    border-bottom: 1px solid var(--linea-papel);
  }
  .linea h3 {
    font-size: 1.35rem;
  }
  .linea p {
    margin: 0;
    color: var(--tinta-2);
  }
  @media (max-width: 860px) {
    .proceso,
    .linea li {
      grid-template-columns: 1fr;
    }
    .linea li {
      gap: 0.4rem;
    }
  }

  .cotizar {
    background: var(--papel-2);
  }
  .cotizar-rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 3rem 5rem;
    align-items: center;
  }
  .cotizar h2 {
    margin-bottom: 1.2rem;
  }
  .cotizar .lead {
    margin-bottom: 2rem;
  }
  .lista-cotizar {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lista-cotizar li {
    position: relative;
    padding: 0.7rem 0 0.7rem 1.5rem;
    border-bottom: 1px solid var(--linea-papel);
  }
  .lista-cotizar li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--tinta-2);
  }
  @media (max-width: 860px) {
    .cotizar-rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>
