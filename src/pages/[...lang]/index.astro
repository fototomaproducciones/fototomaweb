---
import Base from '../../layouts/Base.astro';
import ObraCard from '../../components/ObraCard.astro';
import Foto from '../../components/Foto.astro';
import Logo from '../../components/Logo.astro';
import Creditos from '../../components/Creditos.astro';
import Escuchar from '../../components/Escuchar.astro';
import { OBRA as OBRA_ES, NOMBRES, categoria, enIdioma, type Categoria } from '../../data/obra';
import { DIRECTORES, director } from '../../data/equipo';
import Asociados from '../../components/Asociados.astro';
import { IDIOMAS, idioma, enlace, juntar } from '../../i18n';

export function getStaticPaths() {
  return IDIOMAS();
}
const lang = idioma(Astro.url);
const en = lang === 'en';
const u = (r: string) => enlace(lang, r);

const OBRA = OBRA_ES.map((p) => enIdioma(p, lang));
const fotogramas = en
  ? [
      { img: 'mongolia-fotograma.jpg', pie: 'The last nomads of Mongolia · music and sound design by Martín Perea Tobón', pos: 'center 60%' },
      { img: '17IYYByXjKk.jpg', pie: 'Currulao and the music of the southern Pacific · Dial, 2026', pos: 'center 30%' },
      { img: '5lgpy6H5sTU.jpg', pie: 'Arrabal Gentío — Mangorito', pos: 'center' },
      { img: '4bftwkKm06U.jpg', pie: 'Tierra sin sol ni luna · music by Juan Rizoma', pos: 'center' },
    ]
  : [
  { img: 'mongolia-fotograma.jpg', pie: 'Los últimos nómadas de Mongolia · música y diseño sonoro de Martín Perea Tobón', pos: 'center 60%' },
  { img: '17IYYByXjKk.jpg', pie: 'Currulao y músicas del Pacífico Sur · Dial, 2026', pos: 'center 30%' },
  { img: '5lgpy6H5sTU.jpg', pie: 'Arrabal Gentío — Mangorito', pos: 'center' },
  { img: '4bftwkKm06U.jpg', pie: 'Tierra sin sol ni luna · música de Juan Rizoma', pos: 'center' },
    ];
const mongolia = OBRA.find((p) => p.id === 'mongolia')!;

const frentes = en
  ? [
      {
        id: 'cine',
        titulo: 'Film, series and documentary',
        img: '6uWk6G-3VYs.jpg',
        texto: 'Original music, sound design and final mix. We come in while it is being written, while it is being shot, or when the cut is nearly done.',
        lista: ['Original music to picture', 'Sound design and foley', 'Mixing for cinema, TV and streaming', 'Music supervision', 'Animation and video games'],
        url: '/servicios#cine',
        ejemplo: ejemplo('bardo'),
      },
      {
        id: 'publicidad',
        titulo: 'Advertising and brands',
        img: 'FQ1OpRNI6bM.jpg',
        texto: 'Music and sound for commercials and campaigns, with every version and format each medium asks for.',
        lista: ['Original music and jingles', 'Sound design', 'Sonic identity and sound logo', 'Cutdowns from 6 to 60 seconds', 'Voice-over and mixes for each medium'],
        url: '/publicidad',
        ejemplo: ejemplo('mazda-una-chispa'),
      },
      {
        id: 'sesiones',
        titulo: 'Artists, sessions and media',
        img: 'W32TI7o8XM0.jpg',
        texto: 'We record and film live sessions, produce albums and do the sound for podcasts and shows.',
        lista: ['Recorded and filmed sessions', 'Production and arrangements', 'Music videos', 'Podcasts and radio', 'Mixing and mastering'],
        url: '/servicios#sesiones',
        ejemplo: ejemplo('noisesion'),
      },
    ]
  : [
  {
    id: 'cine',
    titulo: 'Cine, series y documental',
    img: '6uWk6G-3VYs.jpg',
    texto: 'Música original, diseño sonoro y mezcla final. Llegamos cuando se escribe, cuando se filma o con el corte casi listo.',
    lista: ['Música original a la imagen', 'Diseño sonoro y foley', 'Mezcla para sala, TV y plataformas', 'Supervisión musical', 'Animación y videojuegos'],
    url: '/servicios#cine',
    ejemplo: ejemplo('bardo'),
  },
  {
    id: 'publicidad',
    titulo: 'Publicidad y marcas',
    img: 'FQ1OpRNI6bM.jpg',
    texto: 'Música y sonido para comerciales y campañas, con las versiones y los formatos que pide cada medio.',
    lista: ['Música original y jingles', 'Diseño sonoro', 'Identidad y logo sonoro', 'Cortes de 6 a 60 segundos', 'Locución y mezcla por medio'],
    url: '/publicidad',
    ejemplo: ejemplo('mazda-una-chispa'),
  },
  {
    id: 'sesiones',
    titulo: 'Artistas, sesiones y medios',
    img: 'W32TI7o8XM0.jpg',
    texto: 'Grabamos y filmamos sesiones en vivo, producimos discos y hacemos el sonido de podcasts y programas.',
    lista: ['Sesiones grabadas y filmadas', 'Producción y arreglos', 'Videoclips', 'Podcast y radio', 'Mezcla y masterización'],
    url: '/servicios#sesiones',
    ejemplo: ejemplo('noisesion'),
  },
    ];

const principal = OBRA.find((p) => p.id === 'currulao')!;
const pestanas: { id: string; texto: string }[] = [
  { id: 'destacadas', texto: en ? 'Featured' : 'Destacadas' },
  ...(['documental', 'cine', 'publicidad', 'sesiones', 'medios', 'discos'] as Categoria[]).map((c) => ({ id: c, texto: categoria(c, lang) })),
];
const enRejilla = OBRA.filter((p) => p.id !== 'currulao');
const inicial = enRejilla.filter((p) => p.destacada).slice(0, 6);
function ejemplo(id: string) {
  const p = OBRA.find((x) => x.id === id)!;
  return { yt: p.video!, titulo: p.titulo, credito: `${p.rol} — ${juntar(lang, p.quien.map((q) => NOMBRES[q]))}` };
}
const necesidades = en
  ? [
      { texto: 'A film', tema: 'cine' },
      { texto: 'A documentary', tema: 'cine' },
      { texto: 'A commercial', tema: 'publicidad' },
      { texto: 'A live session', tema: 'sesiones' },
      { texto: 'A podcast', tema: 'medios' },
      { texto: 'A video game', tema: 'cine' },
    ]
  : [
  { texto: 'Una película', tema: 'cine' },
  { texto: 'Un documental', tema: 'cine' },
  { texto: 'Un comercial', tema: 'publicidad' },
  { texto: 'Una sesión en vivo', tema: 'sesiones' },
  { texto: 'Un podcast', tema: 'medios' },
  { texto: 'Un videojuego', tema: 'cine' },
    ];
const directores = DIRECTORES.map((d) => director(d, lang));
---

<Base cabeceraSobreFoto>
  <!-- héroe -->
  <section class="heroe">
    <div class="heroe-fotos">
      {
        fotogramas.map((f, i) => (
          <figure class:list={['heroe-foto', { activa: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
            <Foto src={`obra/${f.img}`} sizes="100vw" anchos={[800, 1280, 1920]} prioridad={i === 0} posicion={f.pos} />
            <figcaption class="pie-foto">{f.pie}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="heroe-luz" aria-hidden="true"></div>
    <div class="envoltura heroe-texto">
      <div class="heroe-marca">
        <Logo modo="simbolo" tam={64} animado />
      </div>
      <p class="etq">{en ? 'Music production for film, TV and media' : 'Productora de música para medios audiovisuales'}</p>
      {en ? <h1>Music for <em>the picture</em></h1> : <h1>Música para <em>la imagen</em></h1>}
      <p class="lead">
        {
          en
            ? 'We compose, record and mix the music and sound for films, documentaries, series, commercials and live sessions. We are three co-directors with a network of associate musicians.'
            : 'Componemos, grabamos y mezclamos la música y el sonido de películas, documentales, series, comerciales y sesiones en vivo. Somos tres codirectores con una red de músicos asociados.'
        }
      </p>
      <div class="botones">
        <button
          class="boton lleno heroe-play"
          data-yt={mongolia.video}
          data-titulo={mongolia.titulo}
          data-credito={`${mongolia.rol} — Martín Perea Tobón · ${mongolia.ficha}`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
          {en ? 'Watch the short' : 'Ver el corto'}
        </button>
        <a class="boton flecha" href={u('/obra')}>{en ? 'All our work' : 'Toda la obra'}</a>
      </div>
      <div class="necesito">
        <p class="necesito-pregunta">{en ? 'What do you need music for?' : '¿Para qué necesitas música?'}</p>
        <div class="necesito-botones">
          {
            necesidades.map((n) => (
              <a class="chip" href={u(`/contacto?tema=${n.tema}&para=${encodeURIComponent(n.texto.toLowerCase())}`)}>
                {n.texto}
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <a class="heroe-bajar" href="#hacemos" aria-label={en ? 'Scroll down to what we do' : 'Bajar a qué hacemos'}><span></span></a>
  </section>

  <Creditos />

  <!-- qué hacemos (papel) -->
  <section class="seccion papel" id="hacemos">
    <div class="envoltura">
      <div class="cabeza-seccion rv">
        <div>
          <p class="etq">{en ? 'What we do' : 'Qué hacemos'}</p>
          {en ? <h2>From script to <em>final mix</em></h2> : <h2>Del guion a la <em>mezcla final</em></h2>}
        </div>
        <p class="lead">
          {
            en
              ? 'A score for strings, the noise of a street, a fifteen-second jingle or a band recorded live. We put together whatever team each project needs.'
              : 'Una partitura para cuerdas, el ruido de una calle, un jingle de quince segundos o una banda grabada en vivo. Cada proyecto lo armamos con el equipo que haga falta.'
          }
        </p>
      </div>
      <div class="frentes">
        {
          frentes.map((fr, i) => (
            <article class="frente rv" style={`--d:${i * 0.08}s`}>
              <button
                class="frente-foto marco"
                data-yt={fr.ejemplo.yt}
                data-titulo={fr.ejemplo.titulo}
                data-credito={fr.ejemplo.credito}
                aria-label={en ? `Watch an example: ${fr.ejemplo.titulo}` : `Ver un ejemplo: ${fr.ejemplo.titulo}`}
              >
                <Foto src={`obra/${fr.img}`} sizes="(max-width: 900px) 100vw, 33vw" />
                <span class="frente-ejemplo">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
                  {en ? 'Watch an example' : 'Ver un ejemplo'}
                </span>
              </button>
              <h3>{fr.titulo}</h3>
              <p>{fr.texto}</p>
              <ul class="lista-raya">
                {fr.lista.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
              <div class="frente-acciones">
                <a class="boton flecha" href={u(fr.url)}>{en ? 'More' : 'Ver más'}</a>
                <a class="frente-pedir" href={u(`/contacto?tema=${fr.id}`)}>{en ? 'Get a quote' : 'Cotizar'}</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- obra -->
  <section class="seccion">
    <div class="envoltura">
      <div class="cabeza-seccion rv">
        <div>
          <p class="etq">{en ? 'Work' : 'Obra'}</p>
          <h2>{en ? 'Selected work' : 'Algunos trabajos'}</h2>
        </div>
        <p class="lead">
          {
            en
              ? 'Documentaries, short films, animation, commercials and sessions. Each piece says which of us worked on it and what they did.'
              : 'Documentales, cortometrajes, animación, comerciales y sesiones. Cada pieza dice quién de nosotros la hizo y qué hizo.'
          }
        </p>
      </div>
      <div class="obra-principal rv">
        <ObraCard pieza={principal} grande />
      </div>
      <div class="pestanas" role="tablist" aria-label={en ? 'Type of work' : 'Tipo de trabajo'}>
        {
          pestanas.map((t, i) => (
            <button class:list={['pestana', { activa: i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pestana={t.id}>
              {t.texto}
            </button>
          ))
        }
      </div>
      <div class="rejilla-obra" role="tabpanel">
        {
          enRejilla.map((p) => (
            <div class="celda-obra" data-cats={`${p.categoria}${p.destacada ? ' destacadas' : ''}`} hidden={!inicial.includes(p)}>
              <ObraCard pieza={p} />
            </div>
          ))
        }
      </div>
      <p class="ver-mas rv">
        <a class="boton flecha" href={u('/obra')}>{en ? `All our work · ${OBRA.length} pieces` : `Toda la obra · ${OBRA.length} piezas`}</a>
      </p>
    </div>
  </section>

  <!-- escuchar -->
  <section class="seccion carbon" id="escuchar">
    <div class="envoltura">
      <div class="cabeza-seccion rv">
        <div>
          <p class="etq">{en ? 'Listen' : 'Escuchar'}</p>
          {en ? <h2>What it sounds like <em>without the picture</em></h2> : <h2>Lo que suena cuando <em>no hay imagen</em></h2>}
        </div>
        <p class="lead">
          {
            en
              ? 'Our own music: «Presagio», by Santiago, luci le and Martín; Santiago’s birds, and pieces by Martín between jazz and experimental music. Press play and keep browsing.'
              : 'Música propia de la casa: «Presagio», de Santiago, luci le y Martín; las aves de Santiago, y piezas de Martín entre el jazz y la música experimental. Dale play y sigue mirando el sitio.'
          }
        </p>
      </div>
      <Escuchar />
    </div>
  </section>

  <!-- publicidad (papel) -->
  <section class="seccion papel">
    <div class="envoltura publi">
      <div class="publi-texto rv">
        <p class="etq">{en ? 'For agencies and brands' : 'Para agencias y marcas'}</p>
        {en ? <h2>Music for commercials, <em>ready to air</em></h2> : <h2>Música para comerciales, <em>lista para la pauta</em></h2>}
        <p class="lead">
          {
            en
              ? 'Cutdowns for every length, stems, a mix for each medium and clear usage rights from the first proposal.'
              : 'Versiones por duración, pistas separadas, mezcla para cada medio y una licencia de uso clara desde la propuesta.'
          }
        </p>
        <div class="botones">
          <a class="boton lleno flecha" href={u('/publicidad')}>{en ? 'How we work with brands' : 'Cómo trabajamos con marcas'}</a>
          <a class="boton" href={u('/contacto?tema=publicidad')}>{en ? 'Request a proposal' : 'Pedir una propuesta'}</a>
        </div>
      </div>
      <div class="publi-pieza rv">
        <ObraCard pieza={OBRA.find((p) => p.id === 'mazda-un-color')!} />
      </div>
    </div>
  </section>

  <!-- equipo -->
  <section class="seccion">
    <div class="envoltura">
      <div class="cabeza-seccion rv">
        <div>
          <p class="etq">{en ? 'Co-direction' : 'Codirección'}</p>
          {en ? <h2>Three crafts, <em>one table</em></h2> : <h2>Tres oficios, <em>una mesa</em></h2>}
        </div>
        <p class="lead">
          {
            en
              ? 'Composition and arranging, sound design, music production, engineering and filmmaking. Each project is led by whoever knows most about what it needs.'
              : 'Composición y arreglos, diseño sonoro, producción musical, ingeniería y realización audiovisual. Cada proyecto lo dirige quien más sabe de lo que pide.'
          }
        </p>
      </div>
      <div class="directores">
        {
          directores.map((d, i) => (
            <a class="director rv" href={u(`/equipo#${d.id}`)} style={`--d:${i * 0.08}s`}>
              <div class="director-foto">
                <Foto src={`equipo/${d.foto}`} alt={d.nombre} sizes="(max-width: 820px) 90vw, 30vw" anchos={[400, 640, 900]} />
              </div>
              <p class="director-rol">{d.rol}</p>
              <h3>{d.nombre}</h3>
              <p class="director-corta">{d.corta}</p>
              <span class="director-ver flecha">{en ? 'View profile' : 'Ver perfil'}</span>
            </a>
          ))
        }
      </div>

      <div class="asociados rv">
        <div class="asociados-cabeza">
          <p class="etq">{en ? 'Associate musicians' : 'Músicos asociados'}</p>
          <p class="asociados-texto">
            {
              en
                ? 'For each project we bring in the players the music calls for: strings, winds, voices, percussion, traditional instruments.'
                : 'Para cada proyecto convocamos a los intérpretes que pide la música: cuerdas, vientos, voces, percusiones, instrumentos tradicionales.'
            }
          </p>
          <a class="enlace" href={u('/equipo#asociados')}>{en ? 'See all' : 'Ver todos'}</a>
        </div>
        <Asociados />
      </div>
    </div>
  </section>

  <!-- el nombre: solo una seña; la historia está en /fotofono -->
  <section class="fotofono hueso">
    <a class="envoltura fotofono-franja" href={u('/fotofono')}>
      <figure class="fotofono-grabado">
        <Foto src="fotofono/transmisor.jpg" alt="" sizes="9rem" anchos={[200, 320]} />
      </figure>
      <div class="fotofono-texto">
        <p class="etq">{en ? 'The name' : 'El nombre'}</p>
        {
          en ? (
            <p class="fotofono-frase">
              Fototoma comes from the <em>photophone</em>: in 1880, Bell and Tainter sent a voice along a beam of sunlight.
              Our logo is the mirror that received it.
            </p>
          ) : (
            <p class="fotofono-frase">
              Fototoma viene del <em>fotófono</em>: en 1880, Bell y Tainter mandaron una voz por un rayo de sol. Nuestro
              logo es el espejo que la recibía.
            </p>
          )
        }
      </div>
      <span class="fotofono-ir flecha">{en ? 'The story' : 'La historia'}</span>
    </a>
  </section>

  <!-- cierre sobre imagen -->
  <section class="cierre">
    <div class="cierre-fondo paralaje">
      <Foto src="obra/17IYYByXjKk.jpg" sizes="100vw" anchos={[800, 1280]} posicion="center 30%" />
    </div>
    <div class="envoltura cierre-caja rv">
      <p class="etq">{en ? 'Contact' : 'Contacto'}</p>
      {en ? <h2>Tell us what you are <em>making</em></h2> : <h2>Cuéntanos qué estás <em>haciendo</em></h2>}
      <p class="lead">
        {
          en
            ? 'A script, a cut, a reference or a loose idea is enough to start. We reply with questions, a proposal and a timeline.'
            : 'Un guion, un corte, una referencia o una idea suelta sirven para empezar. Respondemos con preguntas, una propuesta y tiempos.'
        }
      </p>
      <div class="botones">
        <a class="boton lleno flecha" href={u('/contacto')}>{en ? 'Write to us' : 'Escribirnos'}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.heroe')) return;

    // luz que sigue el cursor en el héroe
    const heroe = document.querySelector<HTMLElement>('.heroe')!;
    if (matchMedia('(hover: hover)').matches) {
      heroe.addEventListener('pointermove', (e) => {
        const r = heroe.getBoundingClientRect();
        heroe.style.setProperty('--lx', `${e.clientX - r.left}px`);
        heroe.style.setProperty('--ly', `${e.clientY - r.top}px`);
        heroe.classList.add('con-luz');
      });
      heroe.addEventListener('pointerleave', () => heroe.classList.remove('con-luz'));
    }

    // pestañas de la obra
    const MAX = 6;
    const mostrar = (id: string) => {
      let n = 0;
      document.querySelectorAll<HTMLElement>('.celda-obra').forEach((c) => {
        const ok = (c.dataset.cats || '').split(' ').includes(id) && n < MAX;
        if (ok) n++;
        c.hidden = !ok;
        if (ok) {
          c.classList.remove('entra');
          void c.offsetWidth;
          c.classList.add('entra');
        }
      });
    };
    document.querySelectorAll<HTMLButtonElement>('.pestana').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll('.pestana').forEach((o) => {
          o.classList.toggle('activa', o === b);
          o.setAttribute('aria-selected', o === b ? 'true' : 'false');
        });
        mostrar(b.dataset.pestana!);
      }),
    );

    const fotos = [...document.querySelectorAll<HTMLElement>('.heroe-foto')];
    if (fotos.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let i = 0;
    const t = setInterval(() => {
      if (!document.body.contains(fotos[0])) return clearInterval(t);
      fotos[i].classList.remove('activa');
      i = (i + 1) % fotos.length;
      fotos[i].classList.add('activa');
    }, 7000);
  });
</script>

<style>
  /* héroe */
  .heroe {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 9rem 0 clamp(5rem, 11vh, 8rem);
    overflow: hidden;
    background: var(--noche);
  }
  .heroe-fotos,
  .heroe-foto {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .heroe-foto {
    opacity: 0;
    transition: opacity 2.4s ease;
  }
  .heroe-foto.activa {
    opacity: 1;
  }
  .heroe-foto :global(picture),
  .heroe-foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .heroe-foto :global(img) {
    filter: saturate(0.85) contrast(1.04);
    scale: 1.08;
    transition: scale 9s linear;
  }
  .heroe-foto.activa :global(img) {
    scale: 1;
  }
  .heroe-fotos::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(20, 18, 15, 0.86) 0%, rgba(20, 18, 15, 0.5) 40%, rgba(20, 18, 15, 0) 72%),
      linear-gradient(0deg, rgba(20, 18, 15, 0.9) 0%, rgba(20, 18, 15, 0) 42%),
      linear-gradient(180deg, rgba(20, 18, 15, 0.55) 0%, rgba(20, 18, 15, 0) 22%);
  }
  .heroe-foto figcaption {
    position: absolute;
    right: var(--margen);
    bottom: 1.6rem;
    z-index: 1;
    text-align: right;
    max-width: 22rem;
  }
  .heroe-texto {
    position: relative;
    z-index: 2;
  }
  .heroe-luz {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle 340px at var(--lx, 50%) var(--ly, 50%), rgba(255, 228, 180, 0.16), transparent 70%);
    mix-blend-mode: screen;
    transition: opacity 0.6s var(--suave);
  }
  .con-luz .heroe-luz {
    opacity: 1;
  }
  .necesito {
