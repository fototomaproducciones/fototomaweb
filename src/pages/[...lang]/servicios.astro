---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import { IDIOMAS, idioma, enlace } from '../../i18n';
import { BLOQUES_ES, BLOQUES_EN, PASOS_ES, PASOS_EN, PAGINAS } from '../../data/servicios';

export function getStaticPaths() {
  return IDIOMAS();
}
const lang = idioma(Astro.url);
const en = lang === 'en';
const u = (r: string) => enlace(lang, r);

const bloques = en ? BLOQUES_EN : BLOQUES_ES;
const pasos = en ? PASOS_EN : PASOS_ES;

---

<Base
  titulo={en ? 'Original music, sound design and mixing services' : 'Servicios de música original, diseño sonoro y mezcla'}
  descripcion={
    en
      ? 'Original music, sound design, mixing, music supervision, music for advertising, live sessions, music production and podcasts. Music production company based in Bogotá, Colombia.'
      : 'Música original, diseño sonoro, mezcla, supervisión musical, música para publicidad, sesiones en vivo, producción musical y podcast. Productora de música en Bogotá.'
  }
>
  <section class="seccion">
    <div class="envoltura">
      <p class="etq">{en ? 'Services' : 'Servicios'}</p>
      <h1>{en ? 'All the sound for a project, or whatever part is missing' : 'Todo el sonido de un proyecto, o la parte que falte'}</h1>
      <p class="lead intro">
        {
          en
            ? 'We can take care of the whole soundtrack (music, effects, dialogue and mix) or join an existing team to handle one part. We work in three areas.'
            : 'Podemos hacernos cargo de la banda sonora completa (música, efectos, diálogos y mezcla) o sumarnos a un equipo que ya existe para resolver una parte. Trabajamos en tres frentes.'
        }
      </p>
      <nav class="indice" aria-label={en ? 'On this page' : 'En esta página'}>
        {bloques.map((b) => <a class="enlace" href={`#${b.id}`}>{b.etq}</a>)}
        <a class="enlace" href="#proceso">{en ? 'How we work' : 'Cómo trabajamos'}</a>
      </nav>
    </div>
  </section>

  {
    bloques.map((b, i) => (
      <section class:list={['seccion bloque', { papel: b.id === 'publicidad' }]} id={b.id}>
        <div class="envoltura">
          <figure class="bloque-foto marco paralaje rv">
            <Foto src={`obra/${b.img}`} sizes="100vw" anchos={[800, 1280, 1920]} prioridad={i === 0} />
            <figcaption class="pie-foto">{b.pie}</figcaption>
          </figure>
          <div class="bloque-cabeza rv">
            <p class="etq">{b.etq}</p>
            <h2>{PAGINAS.some((p) => p.id === b.id) ? <a class="titulo-enlace" href={u(`/servicios/${b.id}`)}>{b.titulo}</a> : b.titulo}</h2>
          </div>
          <dl class="servicios">
            {b.servicios.map((s) => (
              <div class="servicio rv">
                <dt>{s.nombre}</dt>
                <dd>{s.texto}</dd>
              </div>
            ))}
          </dl>
          {b.enlace ? (
            <p class="bloque-enlace">
              <a class="boton lleno flecha" href={u(b.enlace.url)}>
                {b.enlace.texto}
              </a>
            </p>
          ) : PAGINAS.some((p) => p.id === b.id) && (
            <p class="bloque-enlace">
              <a class="boton flecha" href={u(`/servicios/${b.id}`)}>
                {en ? 'More about this service' : 'Más sobre este servicio'}
              </a>
            </p>
          )}
        </div>
      </section>
    ))
  }

  <section class="seccion carbon" id="proceso">
    <div class="envoltura">
      <div class="cabeza-seccion rv">
        <div>
          <p class="etq">{en ? 'How we work' : 'Cómo trabajamos'}</p>
          <h2>{en ? 'From the first conversation to delivery' : 'De la primera conversación a la entrega'}</h2>
        </div>
        <p class="lead">
          {
            en
              ? 'The order changes with each project, but it almost always goes through these steps. No fixed rates: each proposal is built around what the piece needs.'
              : 'El orden cambia según el proyecto, pero casi siempre pasa por aquí. Sin precios fijos: cada propuesta se arma con lo que pide la pieza.'
          }
        </p>
      </div>
      <ol class="pasos">
        {
          pasos.map((p) => (
            <li class="paso rv">
              <h3>{p.nombre}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
      <p class="rv"><a class="boton lleno flecha" href={u('/contacto')}>{en ? 'Tell us about a project' : 'Contarnos un proyecto'}</a></p>
    </div>
  </section>
</Base>

<style>
  h1 {
    max-width: 14em;
    margin-bottom: 1.6rem;
  }
  .intro {
    margin-bottom: 2.5rem;
  }
  .indice {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    color: var(--plata-2);
  }
  .bloque-foto {
    position: relative;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--grafito);
  }
  .bloque-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8);
  }
  .bloque-foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent 35%);
  }
  .bloque-foto figcaption {
    position: absolute;
    left: 1rem;
    bottom: 0.8rem;
    z-index: 1;
  }
  @media (max-width: 700px) {
    .bloque-foto {
      aspect-ratio: 16 / 10;
    }
  }
  .bloque-cabeza {
    max-width: 44rem;
    margin-bottom: 3rem;
  }
  .servicios {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 4rem;
    margin: 0;
  }
  .servicio {
    padding: 1.6rem 0;
    border-top: 1px solid var(--linea);
  }
  .papel .servicio {
    border-color: var(--linea-papel);
  }
  .servicio dt {
    font-family: var(--serif);
    font-size: 1.45rem;
    margin-bottom: 0.5rem;
  }
  .servicio dd {
    margin: 0;
    color: var(--plata-2);
  }
  .papel .servicio dd {
    color: var(--tinta-2);
  }
  @media (max-width: 760px) {
    .servicios {
      grid-template-columns: 1fr;
    }
  }
  .titulo-enlace { color: inherit; text-decoration: none; }
  .titulo-enlace:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.12em; }
  .bloque-enlace {
    margin: 2.5rem 0 0;
  }

  .pasos {
    list-style: none;
    padding: 0;
    margin: 0 0 3.5rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2rem;
  }
  .paso {
    position: relative;
    padding-top: 1.6rem;
  }
  /* el haz: una línea que recorre los pasos */
  .paso::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: -2rem;
    height: 1px;
    background: var(--linea);
  }
  .paso::after {
    content: '';
    position: absolute;
    top: -3px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sol);
  }
  .paso:last-child::before {
    right: 0;
  }
  .paso h3 {
    font-size: 1.3rem;
    margin-bottom: 0.6rem;
  }
  .paso p {
    color: var(--plata-2);
    font-size: 0.95rem;
    margin: 0;
  }
  @media (max-width: 980px) {
    .pasos {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .paso {
      padding: 0 0 2rem 1.8rem;
    }
    .paso::before {
      top: 0;
      bottom: 0;
      left: 3px;
      right: auto;
      width: 1px;
      height: auto;
    }
    .paso::after {
      top: 0.45rem;
      left: 0;
    }
  }
</style>
