---
/**
 * Música de fondo (21 nov 2026, la misma de dialmedio.org): el boceto de Fototoma para el documental de Pereira
 * (D:/Fototoma/Pereira/Boceto.wav → public/audio/fototoma-boceto.mp3). Empieza y termina en silencio: el loop no corta.
 * Los navegadores no dejan sonar audio hasta el primer clic, toque o tecla: ahí entra despacio y bajo.
 * Si la persona la apaga, queda apagada (localStorage). Con ClientRouter el audio sigue al cambiar de página.
 * Cede el turno: se calla cuando suena el tocadiscos (html.con-musica) o se abre la sala de video, y vuelve al cerrarlos.
 * El script usa delegación: ClientRouter cambia el botón en cada página.
 */
interface Props {
  en: boolean;
}
const { en } = Astro.props;
---

<button
  type="button"
  class="mus"
  data-musica
  data-src="/audio/fototoma-boceto.mp3"
  data-texto-on={en ? 'Playing' : 'Sonando'}
  data-texto-off={en ? 'Music' : 'Música'}
  data-aria-on={en ? 'Mute the music' : 'Silenciar la música'}
  data-aria-off={en ? 'Play the music' : 'Activar la música'}
  aria-pressed="false"
  aria-label={en ? 'Play the music' : 'Activar la música'}
>
  <span class="mus-barras" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <span class="mus-texto">
    <span class="mus-estado">{en ? 'Music' : 'Música'}</span>
    <span class="mus-credito">{en ? 'A Fototoma sketch for a documentary' : 'Boceto de Fototoma para un documental'}</span>
  </span>
</button>

<script>
  const CLAVE = 'fototoma-musica';
  const POS = 'fototoma-musica-pos';
  const VOLUMEN = 0.32;
  const leer = (s: Storage, k: string) => { try { return s.getItem(k); } catch { return null; } };
  const guardar = (s: Storage, k: string, v: string) => { try { s.setItem(k, v); } catch {} };
  const boton = () => document.querySelector<HTMLButtonElement>('[data-musica]');
  const quiere = () => leer(localStorage, CLAVE) !== 'off';

  let audio: HTMLAudioElement | undefined;
  const obtener = () => {
    if (!audio) {
      audio = new Audio(boton()?.dataset.src || '/audio/fototoma-boceto.mp3');
      audio.loop = true;
      audio.volume = 0;
      const pos = parseFloat(leer(sessionStorage, POS) || '0');
      if (pos) audio.currentTime = pos;
    }
    return audio;
  };

  let fundido = 0;
  const fundir = (meta: number, ms: number, alFinal?: () => void) => {
    const a = obtener();
    cancelAnimationFrame(fundido);
    const desde = a.volume, t0 = performance.now();
    const paso = (t: number) => {
      const k = Math.max(0, Math.min(1, (t - t0) / ms)); // el primer cuadro puede llegar antes de t0
      a.volume = Math.max(0, Math.min(1, desde + (meta - desde) * k));
      if (k < 1) fundido = requestAnimationFrame(paso);
      else alFinal?.();
    };
    fundido = requestAnimationFrame(paso);
  };

  let sonando = false;
  const pintar = () => {
    const b = boton();
    if (!b) return;
    b.classList.toggle('sonando', sonando);
    b.setAttribute('aria-pressed', String(sonando));
    b.setAttribute('aria-label', (sonando ? b.dataset.ariaOn : b.dataset.ariaOff) || '');
    const e = b.querySelector('.mus-estado');
    if (e) e.textContent = (sonando ? b.dataset.textoOn : b.dataset.textoOff) || '';
  };

  // ¿Suena otra cosa? (tocadiscos o sala de video)
  const otraMusica = () =>
    document.documentElement.classList.contains('con-musica') || !!(document.getElementById('sala') as HTMLDialogElement | null)?.open;

  const sonar = async () => {
    if (otraMusica()) return false;
    const a = obtener();
    try {
      if (a.paused) await a.play();
      sonando = true;
      pintar();
      fundir(VOLUMEN, a.currentTime > 1 ? 1200 : 2500);
      return true;
    } catch { return false; }
  };
  const callar = () => {
    if (!audio) return;
    sonando = false;
    pintar();
    fundir(0, 600, () => audio?.pause());
  };

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-musica]')) {
      if (sonando) { guardar(localStorage, CLAVE, 'off'); callar(); }
      else { guardar(localStorage, CLAVE, 'on'); sonar(); }
      return;
    }
    // la sala de video tiene prioridad
    if (t.closest('[data-yt]') && sonando) callar();
  });

  // Primer gesto: si la persona no apagó la música antes. No cuenta un clic que ya pone otra música.
  const primerGesto = (e: Event) => {
    const t = e.target as HTMLElement;
    if (t.closest?.('[data-musica], [data-pista], [data-yt]')) return;
    ['pointerdown', 'keydown'].forEach((x) => document.removeEventListener(x, primerGesto, true));
    if (quiere() && !sonando) sonar();
  };
  if (quiere()) {
    sonar().then((ok) => {
      if (!ok) ['pointerdown', 'keydown'].forEach((x) => document.addEventListener(x, primerGesto, true));
    });
  }

  // Tocadiscos: html.con-musica. Al apagarlo, vuelve el fondo (si la persona no lo había apagado).
  let otraAntes = otraMusica();
  new MutationObserver(() => {
    const otra = otraMusica();
    if (otra === otraAntes) return;
    otraAntes = otra;
    if (otra) { if (sonando) callar(); }
    else if (quiere() && audio && !sonando) sonar();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  document.addEventListener('close', (e) => {
    if ((e.target as HTMLElement).id === 'sala' && quiere() && audio && !sonando) setTimeout(sonar, 50);
  }, true);

  window.addEventListener('pagehide', () => { if (audio && sonando) guardar(sessionStorage, POS, String(audio.currentTime)); });

  // En cada página: repintar el botón nuevo y apartarlo cuando el pie está en pantalla.
  let vigia: IntersectionObserver | undefined;
  document.addEventListener('astro:page-load', () => {
    pintar();
    vigia?.disconnect();
    const pie = document.querySelector('.pie');
    const b = boton();
    if (!pie || !b) return;
    vigia = new IntersectionObserver(([e]) => boton()?.classList.toggle('oculto', e.isIntersecting), { rootMargin: '0px 0px -40px 0px' });
    vigia.observe(pie);
  });
</script>

<style>
  .mus {
    position: fixed;
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 55;
    display: inline-flex;
    align-items: center;
    height: 52px;
    padding: 0 18px;
    background: rgba(20, 18, 15, 0.86);
    color: var(--plata);
    border: 1px solid rgba(224, 168, 78, 0.35);
    box-shadow: 0 14px 34px -10px rgba(0, 0, 0, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-family: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: border-color 0.25s, bottom 0.35s, opacity 0.35s, translate 0.35s;
  }
  :global(html.con-musica) .mus { bottom: calc(var(--td-alto, 80px) + 1.6rem); }
  .mus:hover, .mus:focus-visible { border-color: var(--sol); }
  .mus:focus-visible { outline: 2px solid var(--sol); outline-offset: 3px; }
  .mus-barras { display: inline-flex; align-items: flex-end; gap: 3px; height: 18px; width: 21px; flex: none; }
  .mus-barras i { display: block; width: 3px; height: 4px; background: currentColor; opacity: 0.55; }
  .mus.sonando .mus-barras i { opacity: 1; background: var(--sol); animation: barra 1.6s ease-in-out infinite; }
  .mus.sonando .mus-barras i:nth-child(1) { animation-delay: -0.2s; }
  .mus.sonando .mus-barras i:nth-child(2) { animation-delay: -0.9s; animation-duration: 1.9s; }
  .mus.sonando .mus-barras i:nth-child(3) { animation-delay: -0.5s; animation-duration: 1.4s; }
  .mus.sonando .mus-barras i:nth-child(4) { animation-delay: -1.2s; animation-duration: 2.1s; }
  @keyframes barra { 0%, 100% { height: 4px; } 50% { height: 18px; } }
  .mus-texto { display: grid; gap: 3px; margin-left: 12px; max-width: 0; overflow: hidden; white-space: nowrap; text-align: left; opacity: 0; transition: max-width 0.4s, opacity 0.25s; }
  .mus-credito { font-weight: 400; font-size: 0.72rem; color: var(--plata-2); }
  .mus:hover .mus-texto, .mus:focus-visible .mus-texto { max-width: 22em; opacity: 1; }
  .mus.oculto { opacity: 0; translate: 0 12px; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) {
    .mus.sonando .mus-barras i { animation: none; height: 12px; }
    .mus, .mus-texto { transition: none; }
  }
  @media print { .mus { display: none; } }
</style>
