---
// Cinta de créditos: con quién y para quién hemos trabajado (cada nombre
// sale de una pieza real de la obra o de los perfiles).
const nombres = [
  'Mazda',
  'Señal Colombia',
  'MinCiencias',
  'SENA',
  'IDRD',
  'Señal Colombianísimas',
  'La Noise',
  'Tempestad Films',
  'Sesiones Macarena 360',
  'Alta Distorsión',
  'Radio UNAL',
  'Dial',
  'RED Quynza',
  'Toma Falsa Films',
];
---

<section class="creditos" aria-label="Hemos trabajado para y con">
  <p class="creditos-rotulo">Hemos trabajado para y con</p>
  <div class="creditos-ventana">
    <ul class="creditos-cinta">
      {nombres.map((n) => <li>{n}</li>)}
    </ul>
    <ul class="creditos-cinta" aria-hidden="true">
      {nombres.map((n) => <li>{n}</li>)}
    </ul>
  </div>
</section>

<style>
  .creditos {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.6rem 0 1.6rem var(--margen);
    background: var(--carbon);
    border-block: 1px solid var(--linea);
    overflow: hidden;
  }
  .creditos-rotulo {
    flex: none;
    margin: 0;
    font: 700 0.7rem/1.3 var(--sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gris);
    max-width: 9rem;
  }
  .creditos-ventana {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .creditos-cinta {
    display: flex;
    flex: none;
    gap: 3.2rem;
    padding: 0 0 0 3.2rem;
    margin: 0;
    list-style: none;
    animation: cinta 60s linear infinite;
  }
  .creditos-ventana:hover .creditos-cinta {
    animation-play-state: paused;
  }
  .creditos-cinta li {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.45rem;
    white-space: nowrap;
    color: var(--plata-2);
  }
  .creditos-cinta li {
    display: inline-flex;
    align-items: center;
    gap: 3.2rem;
  }
  .creditos-cinta li::after {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--sol);
  }
  @keyframes cinta {
    to {
      translate: -100% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .creditos-cinta {
      animation: none;
      flex-wrap: wrap;
    }
    .creditos-cinta[aria-hidden] {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .creditos {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
    .creditos-ventana {
      width: 100%;
    }
  }
</style>
