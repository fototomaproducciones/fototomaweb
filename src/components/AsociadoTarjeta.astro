---
// Tarjeta de un músico asociado: foto, oficio y una línea. Lleva a su perfil completo.
import Foto from './Foto.astro';
import type { Asociado } from '../data/equipo';

interface Props {
  a: Asociado;
}
const { a } = Astro.props;
---

<a class="asociado-tarjeta" href={`/equipo/${a.id}`}>
  <div class="at-foto">
    {a.foto && <Foto src={`equipo/${a.foto}`} alt={a.nombre} sizes="(max-width: 600px) 45vw, 14rem" anchos={[320, 480, 640]} />}
  </div>
  {a.instrumentos && <p class="at-rol">{a.instrumentos}</p>}
  <h3 class="at-nombre">{a.nombre}</h3>
  {a.corta && <p class="at-corta">{a.corta}</p>}
  <span class="at-ver flecha">Ver perfil</span>
</a>

<style>
  .asociado-tarjeta {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .at-foto {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--grafito);
    margin-bottom: 1.1rem;
  }
  .at-foto :global(picture),
  .at-foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .at-foto :global(img) {
    transition: scale 1.4s var(--suave);
  }
  .asociado-tarjeta:hover .at-foto :global(img) {
    scale: 1.035;
  }
  .at-rol {
    font: 700 0.7rem/1.4 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sol);
    margin: 0 0 0.5rem;
  }
  .at-nombre {
    font-size: 1.75rem;
    margin: 0 0 0.5rem;
  }
  .at-corta {
    color: var(--plata-2);
    font-size: 0.95rem;
    margin: 0 0 0.9rem;
  }
  .at-ver {
    display: inline-flex;
    gap: 0.5rem;
    font: 700 0.72rem/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--linea);
    transition:
      color 0.25s,
      border-color 0.25s;
  }
  .asociado-tarjeta:hover .at-ver {
    color: var(--sol);
    border-color: var(--sol);
  }
  .asociado-tarjeta:hover .at-ver::after {
    translate: 4px 0;
  }
</style>
