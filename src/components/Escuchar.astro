---
// Estante de discos: cada carátula pone a sonar la pista en el tocadiscos de abajo
// (Base.astro), que sigue sonando aunque se cambie de página.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PISTAS } from '../data/equipo';
import Foto from './Foto.astro';

const caratulas = import.meta.glob<{ default: ImageMetadata }>('/src/assets/pistas/*.jpg', { eager: true });
const lista = await Promise.all(
  PISTAS.map(async (p) => {
    const meta = caratulas[`/src/assets/pistas/${p.img}`].default;
    const mini = await getImage({ src: meta, width: 160, height: 160, format: 'webp', quality: 70 });
    return { ...p, mini: mini.src, clave: p.id ?? p.url! };
  }),
);
const datos = lista.map(({ titulo, quien, tipo, id, url, mini, clave }) => ({ titulo, quien, tipo, id, url, img: mini, clave }));
---

<div class="estante" data-lista={JSON.stringify(datos)}>
  {
    lista.map((p, i) => (
      <button class="disco rv" style={`--d:${i * 0.06}s`} data-pista={JSON.stringify(datos[i])} aria-label={`Escuchar ${p.titulo}, de ${p.quien}`}>
        <span class="disco-caratula">
          <Foto src={`pistas/${p.img}`} sizes="(max-width: 700px) 60vw, 220px" anchos={[300, 500]} />
          <span class="disco-vinilo" aria-hidden="true" />
          <span class="disco-play" aria-hidden="true">
            <svg class="icono-play" viewBox="0 0 24 24">
              <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
            </svg>
            <span class="ondas">
              <i />
              <i />
              <i />
              <i />
            </span>
          </span>
        </span>
        <span class="disco-titulo serif">{p.titulo}</span>
        <span class="disco-quien">{p.quien}</span>
        {p.nota && <span class="disco-nota">{p.nota}</span>}
      </button>
    ))
  }
</div>
<p class="estante-pista">
  <span class="mover" aria-hidden="true">←&nbsp;→</span> Desliza para ver más. La música sigue sonando aunque cambies de página.
</p>

<style>
  .estante {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(190px, 1fr);
    gap: 1.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.5rem 0 1.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--grafito) transparent;
  }
  .disco {
    all: unset;
    cursor: pointer;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .disco:focus-visible .disco-caratula {
    outline: 2px solid var(--sol);
    outline-offset: 4px;
  }
  .disco-caratula {
    position: relative;
    aspect-ratio: 1;
    margin-bottom: 0.9rem;
    isolation: isolate;
  }
  .disco-caratula :global(picture),
  .disco-caratula :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.45);
    transition: translate 0.6s var(--suave);
  }
  /* el disco sale de la funda al pasar el mouse o al sonar */
  .disco-vinilo {
    position: absolute;
    top: 4%;
    left: 4%;
    width: 92%;
    height: 92%;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--sol) 0 9%, #0b0a09 9.5% 11%, transparent 11.5%),
      repeating-radial-gradient(circle, #151311 0 1px, #1d1a17 1.5px 3px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    z-index: 0;
    transition: translate 0.6s var(--suave);
  }
  .disco:hover .disco-vinilo,
  .disco.sonando .disco-vinilo {
    translate: 34% 0;
  }
  .disco.sonando .disco-vinilo {
    animation: girar 2.4s linear infinite;
  }
  @keyframes girar {
    to {
      rotate: 360deg;
    }
  }
  .disco:hover :global(img),
  .disco.sonando :global(img) {
    translate: -6% 0;
  }
  .disco-play {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    z-index: 2;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(20, 18, 15, 0.72);
    color: var(--plata);
    backdrop-filter: blur(4px);
    transition:
      background 0.3s,
      color 0.3s,
      translate 0.6s var(--suave);
  }
  .disco:hover .disco-play,
  .disco.sonando .disco-play {
    background: var(--sol);
    color: var(--tinta);
    translate: -6% 0;
  }
  .icono-play {
    width: 1rem;
    margin-left: 2px;
  }
  .ondas {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 0.95rem;
  }
  .ondas i {
    width: 3px;
    height: 100%;
    background: currentColor;
    animation: onda 0.9s ease-in-out infinite alternate;
  }
  .ondas i:nth-child(2) {
    animation-delay: -0.3s;
  }
  .ondas i:nth-child(3) {
    animation-delay: -0.6s;
  }
  .ondas i:nth-child(4) {
    animation-delay: -0.15s;
  }
  @keyframes onda {
    from {
      scale: 1 0.25;
    }
    to {
      scale: 1 1;
    }
  }
  .ondas i {
    transform-origin: bottom;
  }
  .disco.sonando .icono-play {
    display: none;
  }
  .disco.sonando .ondas {
    display: flex;
  }
  .disco-titulo {
    font-size: 1.35rem;
    line-height: 1.15;
  }
  .disco.sonando .disco-titulo {
    color: var(--sol);
  }
  .disco-quien {
    font-size: 0.9rem;
    color: var(--plata-2);
  }
  .disco-nota {
    font-size: 0.8rem;
    color: var(--gris);
  }
  .estante-pista {
    font-size: 0.85rem;
    color: var(--gris);
    margin: 0.5rem 0 0;
  }
  .mover {
    color: var(--sol);
    margin-right: 0.3rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .disco.sonando .disco-vinilo,
    .ondas i {
      animation: none;
    }
  }
</style>
